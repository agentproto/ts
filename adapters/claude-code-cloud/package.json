{
  "name": "@agentproto/adapter-claude-code-cloud",
  "version": "0.3.0",
  "description": "@agentproto/adapter-claude-code-cloud — AIP-66 managed-cloud-agent adapter for Anthropic Claude Code cloud sessions. Relays `claude --cloud` / `claude -p --cloud` and the undocumented Claude Code sessions API behind an AIP-44 ACP server; the vendor owns the machine and the harness, no agentproto daemon runs inside.",
  "keywords": [
    "agentproto",
    "aip-44",
    "aip-45",
    "aip-66",
    "claude-code",
    "anthropic",
    "cloud",
    "acp",
    "agent-cli",
    "adapter"
  ],
  "homepage": "https://agentproto.sh/docs/aip-45",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "adapters/claude-code-cloud"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "agentproto-claude-code-cloud-acp": "./bin/claude-code-cloud-acp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./CLAUDE-CODE-CLOUD.md": "./CLAUDE-CODE-CLOUD.md",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "CLAUDE-CODE-CLOUD.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.1",
    "@agentproto/adapter-claude-sdk": "workspace:*",
    "@agentproto/driver-agent-cli": "workspace:*",
    "@agentproto/provider-presets": "workspace:*"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
