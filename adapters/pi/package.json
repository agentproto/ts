{
  "name": "@agentproto/adapter-pi",
  "version": "0.3.8",
  "description": "@agentproto/adapter-pi — AIP-45 AGENT-CLI adapter for earendil-works/pi (@earendil-works/pi-coding-agent), driven over pi's persistent JSON-over-stdio RPC mode (`pi --mode rpc`). Implements the `protocol: \"proprietary\"` arm contract. NOTE: pi has no MCP support.",
  "keywords": [
    "agentproto",
    "aip-45",
    "pi",
    "earendil",
    "proprietary",
    "rpc",
    "agent-cli",
    "adapter"
  ],
  "homepage": "https://agentproto.sh/docs/aip-45",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "adapters/pi"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./PI.md": "./PI.md",
    "./PI-RPC.md": "./PI-RPC.md",
    "./MCP-BRIDGE.md": "./MCP-BRIDGE.md",
    "./SECRETS.md": "./SECRETS.md",
    "./SANDBOX.md": "./SANDBOX.md",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "PI.md",
    "PI-RPC.md",
    "MCP-BRIDGE.md",
    "SECRETS.md",
    "SANDBOX.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/driver-agent-cli": "workspace:*",
    "@agentproto/model-catalog": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
