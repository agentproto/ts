{
  "name": "@agentproto/adapter-mastra-controller",
  "version": "0.1.0",
  "description": "@agentproto/adapter-mastra-controller: AIP-45 AGENT-CLI adapter for a Mastra AgentController declared by a `mastra.agent-controller/v1` manifest. Implements the `protocol: \"proprietary\"` arm contract in-process. Runs a live controller session with its modes.",
  "keywords": [
    "agentproto",
    "aip-45",
    "mastra",
    "agent-controller",
    "proprietary",
    "in-process",
    "agent-cli",
    "adapter"
  ],
  "homepage": "https://agentproto.sh/docs/aip-45",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "adapters/mastra-controller"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./MASTRA-CONTROLLER.md": "./MASTRA-CONTROLLER.md",
    "./schema/mastra.agent-controller.v1.schema.json": "./schema/mastra.agent-controller.v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "MASTRA-CONTROLLER.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "schema:write": "AGENTPROTO_WRITE_SCHEMA=1 vitest run src/__tests__/json-schema.test.ts"
  },
  "dependencies": {
    "@agentproto/harness": "workspace:*",
    "gray-matter": "^4.0.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.60.0 <2"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@mastra/core": "1.66.0",
    "@types/node": "^25.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
