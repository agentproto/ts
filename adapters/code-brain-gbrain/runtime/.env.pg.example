# gbrain-pg runtime env — COPY to `.env.pg` (gitignored) and fill in.
# Consumed by `docker compose -f docker-compose.pg.yml --env-file .env.pg up`.

# Admin bootstrap token (>=32 chars) — used to log into gbrain's admin API and
# mint the machine bearer below. Container env: GBRAIN_ADMIN_BOOTSTRAP_TOKEN.
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-32-plus-char-secret

# OpenAI key for embeddings (GBRAIN_EMBEDDING_MODEL=openai:text-embedding-3-large).
OPENAI_API_KEY=sk-replace-me

# CORS origin the gbrain HTTP server accepts. Default http://localhost.
GBRAIN_HTTP_CORS_ORIGIN=http://localhost

# Durable machine bearer for the HTTP adapter (`GbrainHttpProvider`). Mint once
# the container is up, then set here (and export to the adapter's environment):
#   B=http://localhost:3132; BOOT=$GBRAIN_ADMIN_BOOTSTRAP_TOKEN
#   curl -s -c /tmp/gb.jar -H 'Content-Type: application/json' -d "{\"token\":\"$BOOT\"}" $B/admin/login
#   curl -s -b /tmp/gb.jar -H 'Content-Type: application/json' -d '{"name":"agentproto"}' $B/admin/api/api-keys
# The returned `token` (gbrain_…) is a permanent bearer with no expiry.
GBRAIN_BEARER_TOKEN=gbrain_replace-me
