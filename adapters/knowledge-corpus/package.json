{
  "name": "@agentproto/adapter-knowledge-corpus",
  "version": "0.1.0",
  "description": "Composable knowledge adapter: implements @agentproto/knowledge-engine's IKnowledgeProvider over an AIP-10 @agentproto/corpus workspace, wrapping any backing IKnowledgeProvider and hydrating every hit with canonical AIP-10 provenance + access policy. Public ingest/delete are rejected — corpus writes go through the privileged CorpusInternalWriter. Registers as a provider-kit family and ships a node:fs FsPort so it runs standalone.",
  "keywords": [
    "agentproto",
    "knowledge-engine",
    "knowledge",
    "corpus",
    "aip-10",
    "retrieval",
    "rag",
    "provenance",
    "adapter",
    "provider-kit",
    "open-standard",
    "agentic"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "adapters/knowledge-corpus"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/knowledge-engine": "workspace:*",
    "@agentproto/corpus": "workspace:*",
    "@agentproto/provider-kit": "workspace:*"
  },
  "devDependencies": {
    "@agentproto/tool": "workspace:*",
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
