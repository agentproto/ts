{
  "name": "@agentproto/adapter-openclaw",
  "version": "0.1.9",
  "description": "@agentproto/adapter-openclaw — AIP-45 AGENT-CLI adapter for OpenClaw. Spawns `openclaw acp` and bridges OpenClaw's Gateway session over stdio JSON-RPC.",
  "keywords": [
    "agentproto",
    "aip-45",
    "openclaw",
    "acp",
    "agent-cli",
    "adapter"
  ],
  "homepage": "https://agentproto.sh/docs/aip-45",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "adapters/openclaw"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./OPENCLAW.md": "./OPENCLAW.md",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "OPENCLAW.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/driver-agent-cli": "workspace:*"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
