{
  "name": "@agentproto/ts",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "TypeScript implementations of agentproto open standards — AIP-14 tool contracts, AIP-30 driver supertype, kind-specific drivers (CLI/HTTP/MCP/SDK), and framework adapters (Mastra, AI SDK).",
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./adapters/**\" build",
    "pretest": "node scripts/agentflow/docs.mjs --check",
    "test": "pnpm -r --filter \"./packages/**\" --filter \"./adapters/**\" test",
    "check-types": "pnpm -r --filter \"./packages/**\" --filter \"./adapters/**\" check-types",
    "clean": "pnpm -r --filter \"./packages/**\" --filter \"./adapters/**\" clean",
    "scaffold-aip": "node scripts/scaffold-aip.mjs",
    "sync-specs": "node scripts/sync-specs.mjs",
    "sync-specs:check": "node scripts/sync-specs.mjs --check",
    "changeset": "changeset",
    "changeset:auto": "node scripts/auto-changeset.mjs --engine cloud",
    "changeset:ai": "node scripts/auto-changeset.mjs",
    "docs-check": "node scripts/docs-check.mjs",
    "docs-check:dry": "node scripts/docs-check.mjs --dry-run",
    "cli-docs:check": "node scripts/agentflow/docs.mjs --check",
    "cli-docs:ai": "node scripts/agentflow/docs.mjs",
    "review:ai": "node scripts/agentflow/review.mjs",
    "review:loop": "node scripts/agentflow/loop.mjs",
    "prepare": "husky",
    "version": "changeset version",
    "release": "scripts/release.sh",
    "release:ci": "pnpm build && changeset publish",
    "release:npm": "scripts/release.sh --npm-only",
    "release:server": "scripts/release.sh --server-only",
    "release:dry": "scripts/release.sh --dry-run"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.200",
    "@changesets/cli": "^2.31.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "json-schema-to-typescript": "^15.0.4",
    "json-schema-to-zod": "^2.6.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.9.0"
  }
}
