{
  "name": "@agentproto/ts",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "TypeScript implementations of agentproto open standards — AIP-14 tool contracts, AIP-30 driver supertype, kind-specific drivers (CLI/HTTP/MCP/SDK), and framework adapters (Mastra, AI SDK).",
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./adapters/**\" build",
    "test": "pnpm -r --filter \"./packages/**\" --filter \"./adapters/**\" test",
    "check-types": "pnpm -r --filter \"./packages/**\" --filter \"./adapters/**\" check-types",
    "clean": "pnpm -r --filter \"./packages/**\" --filter \"./adapters/**\" clean"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.9.0"
  }
}
