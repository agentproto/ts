{
  "name": "@agentproto/agencies-mastra",
  "version": "0.1.0-alpha.0",
  "description": "Mastra adapter for agentagencies/v1 — PROCEDURE.md → Mastra workflow.ts codegen, engagement orchestrator, Mastra-flavored agencies tools.",
  "keywords": [
    "agentagencies",
    "agencies",
    "mastra",
    "adapter",
    "procedure",
    "workflow",
    "codegen"
  ],
  "homepage": "https://agentproto.sh/docs/agp-1",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/agencies/mastra"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.mjs",
      "default": "./dist/codegen.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentproto/agencies": "workspace:*",
    "@agentproto/governance": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@mastra/core": "*"
  },
  "peerDependenciesMeta": {
    "@mastra/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
