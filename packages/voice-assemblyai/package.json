{
  "name": "@agentproto/voice-assemblyai",
  "version": "0.0.1",
  "private": true,
  "description": "@agentproto/voice-assemblyai: AssemblyAI voice provider for @agentproto/voice. Streaming speech-to-text (Universal Streaming v3 WebSocket) and TTS-1 (WebSocket and HTTP). Talks to AssemblyAI directly; no agent framework.",
  "keywords": [
    "agentproto",
    "voice",
    "assemblyai",
    "tts",
    "stt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/voice-assemblyai"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/voice": "workspace:*",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.9.9",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
