{
  "name": "@agentproto/plugin-local-browser",
  "version": "0.1.0",
  "description": "@agentproto/plugin-local-browser — bridge a real local Chrome profile (cookies, logins, extensions) into the agentproto daemon as an MCP server. Picks one of the user's existing Chrome profiles, clones it into `~/.agentproto/chrome-profile/`, installs `chrome-devtools-mcp` into a plugin-owned dir, and registers it in `~/.agentproto/imported-mcps.json` so the daemon proxies its browser tools through `/mcp`. Tunnel-connected hosts can then drive the user's authenticated browser without any extra plumbing.",
  "keywords": [
    "agentproto",
    "plugin",
    "chrome",
    "chrome-devtools",
    "mcp",
    "local-browser"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/plugin-local-browser"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agentproto-browser": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
