{
  "name": "@agentproto/social",
  "version": "0.1.0-alpha.0",
  "description": "@agentproto/social — platform-neutral social footprint capture (posts, engagement, connections) reduced to AIP-10 corpus sources + a social-graph op stream. Pure: zero runtime, zero filesystem, zero HTTP — all I/O via injected ports (SocialSourcePort, BrowserPort, GraphSinkPort).",
  "keywords": [
    "agentproto",
    "social",
    "footprint",
    "corpus",
    "social-graph",
    "persona",
    "open-standard",
    "agentic"
  ],
  "homepage": "https://agentproto.sh/docs/social",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/social"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.mjs",
      "default": "./dist/ports/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/corpus": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
