{
  "name": "@agentproto/app-kit",
  "version": "2.4.0",
  "description": "DEPRECATED: renamed @agentproto/app. This package re-exports it unchanged.",
  "keywords": [
    "agentproto",
    "aip-53",
    "app",
    "aip-15",
    "defineApp",
    "agent",
    "workflow",
    "open-standard"
  ],
  "homepage": "https://agentproto.sh/docs/aip-53",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/app-kit"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/app": "workspace:*"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.0.0"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@mastra/core": "1.66.0",
    "@types/node": "^25.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
