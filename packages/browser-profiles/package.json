{
  "name": "@agentproto/browser-profiles",
  "version": "0.2.1",
  "description": "Browser session and profile model: saveable session descriptors (zod), Chrome profile discovery, camofox session reuse, and typed injection seams (AuthSignalRegistry, accountSwitcher, SessionSource registry).",
  "keywords": [
    "agentproto",
    "browser",
    "profiles",
    "sessions",
    "chrome",
    "camofox",
    "open-standard",
    "agentic"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/browser-profiles"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/driver-browser": "workspace:*",
    "@agentproto/tool": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.9.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
