{
  "name": "@agentproto/workspace-brain",
  "version": "0.1.0",
  "description": "A per-workspace 'brain': indexes the conversations of a workspace's agent sessions into a queryable knowledge store (BM25) so downstream agents can recall what a workspace's sessions did. Reuses the IKnowledgeProvider contract, the corpus ConversationImporter, and the zero-dep adapter-knowledge-files engine.",
  "keywords": [
    "agentproto",
    "workspace",
    "brain",
    "knowledge",
    "conversation",
    "retrieval",
    "bm25",
    "rag"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/workspace-brain"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/adapter-knowledge-files": "workspace:*",
    "@agentproto/corpus": "workspace:*",
    "@agentproto/knowledge-engine": "workspace:*"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
