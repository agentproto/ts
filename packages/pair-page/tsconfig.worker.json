{
  "extends": "@agentproto/tooling/typescript/bundler.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2022", "WebWorker"],
    "types": ["node"]
  },
  "include": ["src/worker.ts", "src/edge.ts", "src/__tests__/**/*", "scripts/*.d.ts"],
  "exclude": ["dist", "node_modules"]
}
