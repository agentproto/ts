{
  "name": "@agentproto/model-catalog",
  "version": "0.9.1",
  "description": "Unified, dependency-light model catalog: LLM, image, video, audio entries + cost dispatcher + picker. Zod-only; the OSS core that @agstudio/model-catalog layers billing/access/BYOK on top of.",
  "keywords": [
    "agentproto",
    "model-catalog",
    "llm",
    "pricing",
    "model-picker"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/model-catalog"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.mjs",
      "default": "./dist/schema/index.mjs"
    },
    "./schema/voice": {
      "types": "./dist/schema/voice.d.ts",
      "import": "./dist/schema/voice.mjs",
      "default": "./dist/schema/voice.mjs"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.mjs",
      "default": "./dist/llm/index.mjs"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "import": "./dist/image/index.mjs",
      "default": "./dist/image/index.mjs"
    },
    "./video": {
      "types": "./dist/video/index.d.ts",
      "import": "./dist/video/index.mjs",
      "default": "./dist/video/index.mjs"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.mjs",
      "default": "./dist/audio/index.mjs"
    },
    "./voice": {
      "types": "./dist/voice/index.d.ts",
      "import": "./dist/voice/index.mjs",
      "default": "./dist/voice/index.mjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.mjs",
      "default": "./dist/providers/index.mjs"
    },
    "./curation": {
      "types": "./dist/curation/index.d.ts",
      "import": "./dist/curation/index.mjs",
      "default": "./dist/curation/index.mjs"
    },
    "./cost": {
      "types": "./dist/cost/index.d.ts",
      "import": "./dist/cost/index.mjs",
      "default": "./dist/cost/index.mjs"
    },
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "import": "./dist/pricing/index.mjs",
      "default": "./dist/pricing/index.mjs"
    },
    "./byok": {
      "types": "./dist/byok/index.d.ts",
      "import": "./dist/byok/index.mjs",
      "default": "./dist/byok/index.mjs"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "import": "./dist/access/index.mjs",
      "default": "./dist/access/index.mjs"
    },
    "./picker": {
      "types": "./dist/picker/index.d.ts",
      "import": "./dist/picker/index.mjs",
      "default": "./dist/picker/index.mjs"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay/index.mjs",
      "default": "./dist/overlay/index.mjs"
    },
    "./route-identity": {
      "types": "./dist/route-identity/index.d.ts",
      "import": "./dist/route-identity/index.mjs",
      "default": "./dist/route-identity/index.mjs"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
