{
  "name": "@agentproto/inference-endpoint",
  "version": "0.12.0",
  "description": "@agentproto/inference-endpoint — a multi-surface inference proxy gateway. Exposes Anthropic Messages, OpenAI Chat Completions, and OpenAI Responses API surfaces with transparent provider/model routing to Moonshot, OpenRouter, ZAI/Zhipu, Groq, xAI, and OpenAI. Handles Anthropic↔OpenAI schema translation, per-provider tool caps, orphaned-tool-call repair, and thinking-block stripping.",
  "keywords": [
    "agentproto",
    "inference",
    "llm",
    "proxy",
    "anthropic",
    "openai-compat",
    "gateway",
    "open-standard"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/inference-endpoint"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "inference-endpoint": "./dist/cli.mjs",
    "llm-endpoint": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./cli": {
      "import": "./dist/cli.mjs",
      "default": "./dist/cli.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "serve": "tsx watch src/cli.ts",
    "start": "node dist/cli.mjs",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "tsx src/__tests__/e2e.live.ts"
  },
  "dependencies": {
    "@agentproto/auth": "workspace:*",
    "@agentproto/batch": "workspace:*",
    "@agentproto/providers-store": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
