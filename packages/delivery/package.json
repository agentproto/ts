{
  "name": "@agentproto/delivery",
  "version": "0.2.0",
  "description": "@agentproto/delivery - the delivery kernel's pure core (envelope, 0-3 level and tier table, level formula, classifier registry, recent-key window, ledger types) plus an opt-in `@agentproto/delivery/ledger-writer` I/O subpath.",
  "keywords": [
    "agentproto",
    "delivery",
    "envelope",
    "triage",
    "agentic"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/delivery"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./ledger-writer": {
      "types": "./dist/ledger-writer.d.ts",
      "import": "./dist/ledger-writer.mjs",
      "default": "./dist/ledger-writer.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
