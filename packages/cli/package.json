{
  "name": "@agentproto/cli",
  "version": "0.11.1",
  "description": "@agentproto/cli — the `agentproto` binary. Install AIP-45 agent CLI adapters, run them locally, or expose them over a tunnel as a long-running daemon. Reference host for hermes / claude-code / opencode / gemini-cli / goose, all driven through @agentproto/driver-agent-cli.",
  "keywords": [
    "agentproto",
    "aip-45",
    "agent-cli",
    "cli",
    "daemon",
    "claude-code",
    "hermes",
    "opencode",
    "goose",
    "gemini-cli"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "agentproto": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./registry/runtime": {
      "types": "./dist/registry/runtime.d.ts",
      "import": "./dist/registry/runtime.mjs",
      "default": "./dist/registry/runtime.mjs"
    },
    "./registry/builtins": {
      "types": "./dist/registry/builtins.d.ts",
      "import": "./dist/registry/builtins.mjs",
      "default": "./dist/registry/builtins.mjs"
    },
    "./registry/plugins": {
      "types": "./dist/registry/plugins.d.ts",
      "import": "./dist/registry/plugins.mjs",
      "default": "./dist/registry/plugins.mjs"
    },
    "./registry/manifest": {
      "types": "./dist/registry/manifest.d.ts",
      "import": "./dist/registry/manifest.mjs",
      "default": "./dist/registry/manifest.mjs"
    },
    "./util/credentials": {
      "types": "./dist/util/credentials.d.ts",
      "import": "./dist/util/credentials.mjs",
      "default": "./dist/util/credentials.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skill",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/acp": "workspace:*",
    "@agentproto/adapter-browser": "workspace:*",
    "@agentproto/auth": "workspace:*",
    "@agentproto/driver": "workspace:*",
    "@agentproto/driver-agent-cli": "workspace:*",
    "@agentproto/model-catalog": "workspace:*",
    "@agentproto/provider-kit": "workspace:*",
    "@agentproto/rendezvous": "workspace:*",
    "@agentproto/runtime-profile-standard": "workspace:*",
    "@agentproto/sandbox-box": "workspace:*",
    "@agentproto/sandbox-e2b": "workspace:*",
    "@agentproto/secrets": "workspace:*",
    "@agentproto/worktree": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "chalk": "^5.0.0",
    "cli-highlight": "^2.1.11",
    "gray-matter": "^4.0.3",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@agentproto/adapter-claude-code": "workspace:*",
    "@agentproto/adapter-claude-sdk": "workspace:*",
    "@agentproto/adapter-codex": "workspace:*",
    "@agentproto/adapter-gemini": "workspace:*",
    "@agentproto/adapter-hermes": "workspace:*",
    "@agentproto/adapter-mastra-agent": "workspace:*",
    "@agentproto/adapter-mastracode": "workspace:*",
    "@agentproto/adapter-mastracode-inprocess": "workspace:*",
    "@agentproto/adapter-openclaw": "workspace:*",
    "@agentproto/adapter-opencode": "workspace:*",
    "@agentproto/adapter-pi": "workspace:*",
    "@agentproto/agent-runtime": "workspace:*",
    "@agentproto/runtime": "workspace:*",
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
