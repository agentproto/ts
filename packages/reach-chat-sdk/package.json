{
  "name": "@agentproto/reach-chat-sdk",
  "version": "0.0.0",
  "description": "@agentproto/reach-chat-sdk - the chat-sdk REACH adapter kind: reaches a human through a Chat SDK messenger adapter. First platform WhatsApp (Cloud API), tell only, outbound only. Optional for @agentproto/runtime, loaded only when a route has a chat-sdk entry.",
  "keywords": [
    "agentproto",
    "reach",
    "chat-sdk",
    "whatsapp",
    "agentic"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/reach-chat-sdk"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/reach": "workspace:*",
    "@chat-adapter/state-memory": "4.44.0",
    "@chat-adapter/whatsapp": "4.44.0",
    "chat": "4.44.0"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
