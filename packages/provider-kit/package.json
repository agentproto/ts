{
  "name": "@agentproto/provider-kit",
  "version": "0.1.0",
  "description": "@agentproto/provider-kit — generic provider/backend catalog, status, creds, setup-ledger, and MCP tool primitives shared by the agent-CLI, browser, tunnel, and eval-reporter families.",
  "keywords": [
    "agentproto",
    "adapter",
    "catalog",
    "mcp",
    "creds",
    "status"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/provider-kit"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "default": "./dist/types.mjs"
    },
    "./creds": {
      "types": "./dist/creds-store.d.ts",
      "import": "./dist/creds-store.mjs",
      "default": "./dist/creds-store.mjs"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "import": "./dist/ledger.mjs",
      "default": "./dist/ledger.mjs"
    },
    "./list-resolve": {
      "types": "./dist/list-resolve.d.ts",
      "import": "./dist/list-resolve.mjs",
      "default": "./dist/list-resolve.mjs"
    },
    "./mcp-tools": {
      "types": "./dist/mcp-tools.d.ts",
      "import": "./dist/mcp-tools.mjs",
      "default": "./dist/mcp-tools.mjs"
    },
    "./wizard": {
      "types": "./dist/wizard.d.ts",
      "import": "./dist/wizard.mjs",
      "default": "./dist/wizard.mjs"
    },
    "./discover": {
      "types": "./dist/discover.d.ts",
      "import": "./dist/discover.mjs",
      "default": "./dist/discover.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
