{
  "name": "create-agentproto-app",
  "version": "0.3.0",
  "description": "create-agentproto-app — scaffold an agentproto agent app: the .agentproto/ shell (APP.md, an agent, a workflow) plus a Vite + TanStack Router + TanStack Query ui/ project that builds to static files in .agentproto/ui/. Run with `pnpm create agentproto-app <dir>`.",
  "keywords": [
    "agentproto",
    "create",
    "scaffold",
    "vite",
    "tanstack",
    "open-standard"
  ],
  "homepage": "https://agentproto.sh/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/create-agentproto-app"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "create-agentproto-app": "dist/index.mjs"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "@agentproto/app-client": "workspace:*"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.mjs",
      "default": "./dist/scaffold.mjs"
    },
    "./package.json": "./package.json"
  }
}
