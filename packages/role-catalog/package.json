{
  "name": "@agentproto/role-catalog",
  "version": "0.1.1",
  "description": "Reference catalogue of AIP-47 ROLE.md builtins — 15 starter roles (executive, specialist, coordinator) covering common AI-company positions. Composed via @agentproto/role; consumed via BuiltinRoleSource.",
  "keywords": [
    "agentproto",
    "aip-47",
    "role",
    "role-catalog",
    "open-standard",
    "agentic"
  ],
  "homepage": "https://agentproto.sh/docs/aip-47",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/role-catalog"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/policy": "workspace:*",
    "@agentproto/role": "workspace:*"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
