{
  "name": "@agentproto/catalog-sync",
  "version": "0.5.8",
  "description": "Build-time generator framework for @agentproto/model-catalog. Generates *.generated.ts from pinned provider sources (LLM, image, video, audio, voice).",
  "keywords": [
    "agentproto",
    "catalog-sync",
    "model-catalog",
    "generator",
    "codegen"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/catalog-sync"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "snapshots",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "catalog-sync": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "default": "./dist/types.mjs"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.mjs",
      "default": "./dist/runner.mjs"
    },
    "./generators/llm-openrouter": {
      "types": "./dist/generators/llm-openrouter.d.ts",
      "import": "./dist/generators/llm-openrouter.mjs",
      "default": "./dist/generators/llm-openrouter.mjs"
    },
    "./generators/llm-requesty": {
      "types": "./dist/generators/llm-requesty.d.ts",
      "import": "./dist/generators/llm-requesty.mjs",
      "default": "./dist/generators/llm-requesty.mjs"
    },
    "./refresh-workflow": {
      "types": "./dist/refresh-workflow.d.ts",
      "import": "./dist/refresh-workflow.mjs",
      "default": "./dist/refresh-workflow.mjs"
    },
    "./sources/openai": {
      "types": "./dist/sources/openai.d.ts",
      "import": "./dist/sources/openai.mjs",
      "default": "./dist/sources/openai.mjs"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/model-catalog": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
