{
  "name": "@agentproto/catalog",
  "version": "0.1.0",
  "description": "@agentproto/catalog — agentcatalog/v1 reference implementation. A multi-source, tier-aware catalog primitive that composes N CatalogSources (builtin / curated / marketplace / private / collection) into a single deduplicated fetch surface. One impl, every entity family (skills, operators, runtimes, integrations, ...).",
  "keywords": [
    "agentproto",
    "agentcatalog",
    "catalog",
    "registry",
    "open-standard",
    "agentic"
  ],
  "homepage": "https://agentproto.sh/docs/agentcatalog",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/catalog"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
