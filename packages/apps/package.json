{
  "name": "@agentproto/apps",
  "version": "0.2.2",
  "description": "@agentproto/apps — a home for ready-made agentproto apps (teams of agents + their workflows), declared with @agentproto/app-kit. Import a team (code-team, content-team, …) and use any of its agents/workflows from your own host: in-process via toMastraAgents(), or emit its manifests to disk.",
  "keywords": [
    "agentproto",
    "app",
    "agents",
    "team",
    "code-team",
    "app-kit",
    "open-standard"
  ],
  "homepage": "https://agentproto.sh/docs/aip-42",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/apps"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./code-team": {
      "types": "./dist/code-team/index.d.ts",
      "import": "./dist/code-team.mjs",
      "default": "./dist/code-team.mjs"
    },
    "./content-team": {
      "types": "./dist/content-team/index.d.ts",
      "import": "./dist/content-team.mjs",
      "default": "./dist/content-team.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/agent": "workspace:*",
    "@agentproto/app-kit": "workspace:*",
    "@agentproto/workflow": "workspace:*"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.0.0"
  },
  "devDependencies": {
    "@agentproto/mastra": "workspace:*",
    "@agentproto/tooling": "workspace:*",
    "@mastra/core": "1.55.0",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
