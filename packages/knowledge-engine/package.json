{
  "name": "@agentproto/knowledge-engine",
  "version": "0.2.1",
  "description": "Pure, backend-agnostic knowledge (retrieval) contract (IKnowledgeProvider) + the AIP-14 `kb_query` / `kb_ingest` tools, their AIP-30 builtin provider, and AIP-29/31/32 surface projections. Names no retrieval engine — a backend is injected via the tool context.",
  "keywords": [
    "agentproto",
    "aip-14",
    "aip-30",
    "knowledge-engine",
    "knowledge",
    "retrieval",
    "rag",
    "kb-query",
    "kb-ingest",
    "open-standard",
    "agentic"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/knowledge-engine"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "default": "./dist/types.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.mjs",
      "default": "./dist/tools/index.mjs"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "import": "./dist/provider/index.mjs",
      "default": "./dist/provider/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.mjs",
      "default": "./dist/mcp/index.mjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.mjs",
      "default": "./dist/http/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.mjs",
      "default": "./dist/cli/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/driver": "workspace:*",
    "@agentproto/driver-cli": "workspace:*",
    "@agentproto/driver-http": "workspace:*",
    "@agentproto/driver-mcp": "workspace:*",
    "@agentproto/tool": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
