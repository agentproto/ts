{
  "name": "@agentproto/product",
  "version": "0.2.0",
  "description": "@agentproto/product — AIP-55 reference implementation. The pricing capability: attach a price (one-time | prepaid-pool | pay-per-call) + a billingRail (stripe/autumn/tbd) to ANY AIP artifact via an AIP-54 ArtifactRef. Target AIPs need zero pricing awareness.",
  "keywords": [
    "agentproto",
    "aip-55",
    "product",
    "pricing",
    "billing",
    "open-standard",
    "agentic"
  ],
  "homepage": "https://agentproto.sh/docs/aip-55",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/product"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/ref": "workspace:*"
  },
  "devDependencies": {
    "@agentproto/app-kit": "workspace:*",
    "@agentproto/pack": "workspace:*",
    "@agentproto/registry": "workspace:*",
    "@agentproto/tool": "workspace:*",
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
