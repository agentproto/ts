  "_note": "Section 'Request: events/stream'. The heartbeatMs comment of the jsonc example is dropped.",
  "body": {
    "jsonrpc": "2.0",
    "method": "events/stream",
    "id": 1,
    "params": {
      "name": "email.received",
      "arguments": {
        "from": "*@anthropic.com",
        "redact_pii": true
