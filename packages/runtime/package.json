{
  "name": "@agentproto/runtime",
  "version": "1.1.0",
  "description": "@agentproto/runtime — long-running gateway that turns an agentproto workspace into a live runtime. Composes @agentproto/mcp-server (CRUD verbs) with HTTP transport, HEARTBEAT.md autonomy loop, and append-only conversation persistence. Drop a workspace dir, point your MCP client at it, and the agent ticks on its own.",
  "keywords": [
    "agentproto",
    "runtime",
    "gateway",
    "mcp",
    "heartbeat",
    "autonomy"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./catalog-models": {
      "types": "./dist/catalog-models.d.ts",
      "import": "./dist/catalog-models.mjs",
      "default": "./dist/catalog-models.mjs"
    },
    "./conversations": {
      "types": "./dist/conversations.d.ts",
      "import": "./dist/conversations.mjs",
      "default": "./dist/conversations.mjs"
    },
    "./heartbeat": {
      "types": "./dist/heartbeat.d.ts",
      "import": "./dist/heartbeat.mjs",
      "default": "./dist/heartbeat.mjs"
    },
    "./workspace-fs": {
      "types": "./dist/workspace-fs.d.ts",
      "import": "./dist/workspace-fs.mjs",
      "default": "./dist/workspace-fs.mjs"
    },
    "./package.json": "./package.json",
    "./pr-provenance": {
      "types": "./dist/pr-provenance.d.ts",
      "import": "./dist/pr-provenance.mjs",
      "default": "./dist/pr-provenance.mjs"
    },
    "./workspaces-config": {
      "types": "./dist/workspaces-config.d.ts",
      "import": "./dist/workspaces-config.mjs",
      "default": "./dist/workspaces-config.mjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./providers-store": {
      "types": "./dist/providers-store.d.ts",
      "import": "./dist/providers-store.mjs",
      "default": "./dist/providers-store.mjs"
    },
    "./mcp-imports": {
      "types": "./dist/mcp-imports.d.ts",
      "import": "./dist/mcp-imports.mjs",
      "default": "./dist/mcp-imports.mjs"
    },
    "./resume-strategies": {
      "types": "./dist/resume-strategies.d.ts",
      "import": "./dist/resume-strategies.mjs",
      "default": "./dist/resume-strategies.mjs"
    },
    "./session-story": {
      "types": "./dist/session-story.d.ts",
      "import": "./dist/session-story.mjs",
      "default": "./dist/session-story.mjs"
    },
    "./session-story-panel": {
      "types": "./dist/session-story-panel.d.ts",
      "import": "./dist/session-story-panel.mjs",
      "default": "./dist/session-story-panel.mjs"
    },
    "./user-presets": {
      "types": "./dist/user-presets.d.ts",
      "import": "./dist/user-presets.mjs",
      "default": "./dist/user-presets.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "sim:inbound": "vite-node scripts/simulate-inbound.mjs",
    "telegram:proxy": "vite-node scripts/telegram-proxy.mjs"
  },
  "dependencies": {
    "@agentproto/acp": "workspace:*",
    "@agentproto/auth": "workspace:*",
    "@agentproto/command-sandbox": "workspace:*",
    "@agentproto/driver": "workspace:*",
    "@agentproto/driver-agent-cli": "workspace:*",
    "@agentproto/tool": "workspace:*",
    "@agentproto/workflow": "workspace:*",
    "@agentproto/workflow-loader": "workspace:*",
    "@agentproto/workflow-runtime": "workspace:*",
    "croner": "^9.0.0",
    "@agentproto/provider-kit": "workspace:*",
    "@agentproto/provider-presets": "workspace:*",
    "@agentproto/eval-reporters": "workspace:*",
    "@agentproto/agent": "workspace:*",
    "@agentproto/manifest": "workspace:*",
    "@agentproto/mcp-server": "workspace:*",
    "@agentproto/model-catalog": "workspace:*",
    "@agentproto/routine": "workspace:*",
    "@agentproto/providers-store": "workspace:*",
    "@agentproto/redaction": "workspace:*",
    "@agentproto/sandbox": "workspace:*",
    "@agentproto/secrets": "workspace:*",
    "@agentproto/telemetry-langfuse": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "gray-matter": "^4.0.3",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@agentproto/sandbox-e2b": "workspace:*"
  },
  "devDependencies": {
    "@agentproto/rendezvous": "workspace:*",
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "@types/ws": "^8.5.13",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
