{
  "name": "@agentproto/voice-openai",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "@agentproto/voice-openai: OpenAI voice provider for @agentproto/voice. Whisper file transcription, speech synthesis (TTS) and the Realtime API (speech-to-speech with server VAD). Talks to OpenAI directly; no agent framework.",
  "keywords": [
    "agentproto",
    "voice",
    "openai",
    "whisper",
    "tts",
    "realtime"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/voice-openai"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/voice": "workspace:*",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.9.9",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
