{
  "name": "@agentproto/billing-stripe",
  "version": "0.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "@agentproto/billing-stripe: Stripe settlement provider for @agentproto/billing (AIP-74). Webhook signature verification, mode guard and the money facts of checkouts, invoices, refunds and disputes.",
  "keywords": [
    "agentproto",
    "aip-74",
    "billing",
    "stripe",
    "webhooks",
    "settlement"
  ],
  "homepage": "https://agentproto.sh/docs/aip-74",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/billing-stripe"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/billing": "workspace:*"
  },
  "peerDependencies": {
    "stripe": ">=23.0.0"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.9.9",
    "stripe": "^23.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
