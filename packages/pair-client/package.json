{
  "name": "@agentproto/pair-client",
  "version": "0.1.0",
  "description": "@agentproto/pair-client — browser-safe client for agentproto E2E daemon pairing. Pair from an offer QR, keep the credential in IndexedDB, and reach the daemon with a WHATWG fetch (streamed bodies, SSE) multiplexed over one rendezvous WebSocket, with reconnect and a typed revocation error.",
  "keywords": [
    "agentproto",
    "pairing",
    "e2e",
    "rendezvous",
    "tunnel",
    "browser",
    "service-worker"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/pair-client"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/acp": "workspace:*",
    "@agentproto/secrets": "workspace:*"
  },
  "devDependencies": {
    "@agentproto/rendezvous": "workspace:*",
    "@agentproto/runtime": "workspace:*",
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.9.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "ws": "^8.21.3"
  }
}
