{
  "name": "@agentproto/ref",
  "version": "0.1.0-alpha.0",
  "description": "agentref/v1 (AIP-27) — composable reference primitive. Typed, registry-extensible discriminated union with a canonical compact string form. Eleven base kinds (local, url, git, github, ipfs, email, operator, user, persona, eth_tx, ots) cover the pointer surfaces existing AIPs need; extension kinds register at the implementation boundary.",
  "keywords": [
    "agentref",
    "ref",
    "reference",
    "pointer",
    "aip-27",
    "agentproto",
    "open-standard",
    "agentic"
  ],
  "homepage": "https://agentproto.sh/docs/aip-27",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/ref"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./kinds": {
      "types": "./dist/kinds/index.d.ts",
      "import": "./dist/kinds/index.mjs",
      "default": "./dist/kinds/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
