{
  "name": "@agentproto/sandbox-computer",
  "version": "0.3.0",
  "description": "@agentproto/sandbox-computer — `SandboxProvider` for @agentproto/sandbox backed by a self-hosted microVM computer controller. Boots the agentproto daemon inside the computer, exposes its MCP endpoint, pauses (suspend) / resumes / detaches (rm) across the controller's HTTP API, and supports several agentproto sessions sharing one computer (`sharedSessions`).",
  "keywords": [
    "agentproto",
    "aip-36",
    "sandbox",
    "computer",
    "microvm",
    "open-standard",
    "agentic"
  ],
  "homepage": "https://agentproto.sh/docs/aip-36",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/sandbox-computer"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/computer-api": "workspace:*",
    "@agentproto/sandbox": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.9.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
