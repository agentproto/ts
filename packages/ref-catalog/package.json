{
  "name": "@agentproto/ref-catalog",
  "version": "0.2.0",
  "description": "@agentproto/ref-catalog — AIP-54 reference implementation. One typed, cross-AIP reference primitive: ArtifactRef ({aip, id, version}) + aip:// URI serialization, resolved through per-family AIP-43 registries joined by RefCatalog. One reference mechanism for every AIP — replaces per-primitive xRef fields (AIP-18 refKind, app-kit inline handles, AIP-55 appRef/packRef).",
  "keywords": [
    "agentproto",
    "aip-54",
    "ref",
    "reference",
    "registry",
    "open-standard",
    "agentic"
  ],
  "homepage": "https://agentproto.sh/docs/aip-54",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/ref-catalog"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@agentproto/registry": "workspace:*",
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
