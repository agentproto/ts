{
  "name": "agentproto-vscode",
  "displayName": "agentproto",
  "description": "Live operational views for the agentproto daemon — sessions, permissions, cost — plus spawn/drive/kill from the editor.",
  "version": "0.0.1",
  "publisher": "agentproto",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts"
  },
  "files": [
    "dist",
    "media",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm run build && pnpm dlx @vscode/vsce package --out agentproto-vscode-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentproto",
          "title": "agentproto",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "agentproto": [
        {
          "id": "agentproto.sessions",
          "name": "Sessions"
        },
        {
          "id": "agentproto.permissions",
          "name": "Permissions"
        }
      ]
    },
    "commands": [
      {
        "command": "agentproto.refresh",
        "title": "agentproto: Refresh",
        "category": "agentproto"
      },
      {
        "command": "agentproto.spawnAgent",
        "title": "agentproto: Spawn Agent",
        "category": "agentproto",
        "icon": "$(add)"
      },
      {
        "command": "agentproto.promptSession",
        "title": "agentproto: Prompt Session",
        "category": "agentproto",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentproto.interruptSession",
        "title": "agentproto: Interrupt Session",
        "category": "agentproto",
        "icon": "$(debug-pause)"
      },
      {
        "command": "agentproto.killSession",
        "title": "agentproto: Kill Session",
        "category": "agentproto",
        "icon": "$(trash)"
      },
      {
        "command": "agentproto.openTranscript",
        "title": "agentproto: Open Transcript",
        "category": "agentproto",
        "icon": "$(open-preview)"
      },
      {
        "command": "agentproto.openTranscriptChannel",
        "title": "agentproto: Open Transcript (Raw Output Channel)",
        "category": "agentproto"
      },
      {
        "command": "agentproto.approvePermission",
        "title": "agentproto: Approve Permission",
        "category": "agentproto",
        "icon": "$(check)"
      },
      {
        "command": "agentproto.denyPermission",
        "title": "agentproto: Deny Permission",
        "category": "agentproto",
        "icon": "$(close)"
      },
      {
        "command": "agentproto.showHealth",
        "title": "agentproto: Show Daemon Health",
        "category": "agentproto"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentproto.refresh",
          "when": "view == 'agentproto.sessions' || view == 'agentproto.permissions'",
          "group": "navigation"
        },
        {
          "command": "agentproto.spawnAgent",
          "when": "view == 'agentproto.sessions'",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentproto.promptSession",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting)$/",
          "group": "inline@1"
        },
        {
          "command": "agentproto.interruptSession",
          "when": "view == agentproto.sessions && viewItem == session-live",
          "group": "inline@2"
        },
        {
          "command": "agentproto.killSession",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting)$/",
          "group": "inline@3"
        },
        {
          "command": "agentproto.openTranscript",
          "when": "view == agentproto.sessions && viewItem =~ /^session-/",
          "group": "inline@4"
        },
        {
          "command": "agentproto.openTranscriptChannel",
          "when": "view == agentproto.sessions && viewItem =~ /^session-/",
          "group": "transcript@1"
        },
        {
          "command": "agentproto.approvePermission",
          "when": "view == agentproto.permissions && viewItem == permission-pending",
          "group": "inline@1"
        },
        {
          "command": "agentproto.denyPermission",
          "when": "view == agentproto.permissions && viewItem == permission-pending",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "agentproto",
      "properties": {
        "agentproto.daemonUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18790",
          "description": "Base URL of the local agentproto daemon."
        },
        "agentproto.tokenPath": {
          "type": "string",
          "default": "",
          "description": "Optional explicit path to the daemon's runtime.json token file. Empty = auto-resolve (workspace .agentproto/runtime.json, then ~/.agentproto/daemons/<port>.json)."
        },
        "agentproto.pollIntervalMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "Fallback poll interval (ms) when the session_events_poll loop is unhealthy."
        }
      }
    }
  }
}
