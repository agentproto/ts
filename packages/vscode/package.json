{
  "name": "agentproto-vscode",
  "displayName": "agentproto",
  "description": "Live operational views for the agentproto daemon — sessions, permissions, cost — plus spawn/drive/stop from the editor.",
  "version": "0.2.0",
  "publisher": "agentproto",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts"
  },
  "files": [
    "dist",
    "media",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm run build && mkdir -p output && pnpm dlx @vscode/vsce package --no-dependencies --out output/"
  },
  "dependencies": {
    "@agentproto/runtime": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentproto",
          "title": "agentproto",
          "icon": "media/activitybar.svg"
        },
        {
          "id": "agentprotoConfig",
          "title": "Agentproto Lab",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "agentproto": [
        {
          "id": "agentproto.sessions",
          "name": "Sessions",
          "when": "config.agentproto.sessionsView == 'tree'"
        },
        {
          "id": "agentproto.sessionsWebview",
          "name": "Sessions",
          "type": "webview",
          "when": "config.agentproto.sessionsView == 'webview'"
        },
        {
          "id": "agentproto.permissions",
          "name": "Permissions"
        },
        {
          "id": "agentproto.harnesses",
          "name": "Harnesses",
          "when": "config.agentproto.harnessesView == 'tree'"
        },
        {
          "id": "agentproto.harnessesWebview",
          "name": "Harnesses",
          "type": "webview",
          "when": "config.agentproto.harnessesView == 'webview'"
        },
        {
          "id": "agentproto.authProfiles",
          "name": "Auth Profiles",
          "when": "config.agentproto.authProfilesView == 'tree'"
        },
        {
          "id": "agentproto.authProfilesWebview",
          "name": "Auth Profiles",
          "type": "webview",
          "when": "config.agentproto.authProfilesView == 'webview'"
        }
      ],
      "agentprotoConfig": [
        {
          "id": "agentproto.configurationLab",
          "name": "Configuration Lab",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agentproto.refresh",
        "title": "agentproto: Refresh",
        "category": "agentproto",
        "icon": "$(refresh)"
      },
      {
        "command": "agentproto.selectWorkspace",
        "title": "agentproto: Select Target Workspace",
        "category": "agentproto",
        "icon": "$(root-folder)"
      },
      {
        "command": "agentproto.spawnAgent",
        "title": "agentproto: Spawn Agent",
        "category": "agentproto",
        "icon": "$(add)"
      },
      {
        "command": "agentproto.openConfigurationLab",
        "title": "agentproto: Open Configuration Lab",
        "category": "agentproto",
        "icon": "$(gear)"
      },
      {
        "command": "agentproto.promptSession",
        "title": "agentproto: Prompt Session",
        "category": "agentproto",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentproto.interruptSession",
        "title": "agentproto: Interrupt Session",
        "category": "agentproto",
        "icon": "$(debug-pause)"
      },
      {
        "command": "agentproto.killSession",
        "title": "agentproto: Stop Session",
        "category": "agentproto",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentproto.restartSession",
        "title": "agentproto: Restart Session (New Session)",
        "category": "agentproto",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentproto.resumeSession",
        "title": "agentproto: Resume Session In Place",
        "category": "agentproto",
        "icon": "$(debug-continue)"
      },
      {
        "command": "agentproto.setSessionAccessProfile",
        "title": "agentproto: Set Session Auth Profile",
        "category": "agentproto",
        "icon": "$(key)"
      },
      {
        "command": "agentproto.renameSession",
        "title": "agentproto: Rename Session",
        "category": "agentproto",
        "icon": "$(edit)"
      },
      {
        "command": "agentproto.saveFavorite",
        "title": "agentproto: Save as Favorite…",
        "category": "agentproto",
        "icon": "$(star-full)"
      },
      {
        "command": "agentproto.archiveSession",
        "title": "agentproto: Archive Session",
        "category": "agentproto",
        "icon": "$(archive)"
      },
      {
        "command": "agentproto.unarchiveSession",
        "title": "agentproto: Unarchive Session",
        "category": "agentproto",
        "icon": "$(discard)"
      },
      {
        "command": "agentproto.toggleShowArchived",
        "title": "agentproto: Toggle Archived Sessions",
        "category": "agentproto",
        "icon": "$(archive)"
      },
      {
        "command": "agentproto.setSessionGrouping",
        "title": "agentproto: Group Sessions By…",
        "category": "agentproto",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "agentproto.expandAllSessions",
        "title": "agentproto: Expand All Sessions",
        "category": "agentproto",
        "icon": "$(expand-all)"
      },
      {
        "command": "agentproto.cleanEndedSessions",
        "title": "agentproto: Clean Up Ended Sessions",
        "category": "agentproto",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentproto.cleanWorktrees",
        "title": "agentproto: Clean Up Worktrees…",
        "category": "agentproto",
        "icon": "$(trash)"
      },
      {
        "command": "agentproto.toggleGroupByWorkspace",
        "title": "agentproto: Toggle Group Sessions By Workspace",
        "category": "agentproto"
      },
      {
        "command": "agentproto.createWorkspace",
        "title": "agentproto: Create Workspace Here",
        "category": "agentproto",
        "icon": "$(add)"
      },
      {
        "command": "agentproto.importConversation",
        "title": "agentproto: Import Claude Conversation",
        "category": "agentproto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentproto.filterSessions",
        "title": "agentproto: Filter Sessions",
        "category": "agentproto",
        "icon": "$(filter)"
      },
      {
        "command": "agentproto.searchSessions",
        "title": "agentproto: Search Sessions",
        "category": "agentproto",
        "icon": "$(search)"
      },
      {
        "command": "agentproto.openTranscript",
        "title": "agentproto: Open Transcript",
        "category": "agentproto",
        "icon": "$(open-preview)"
      },
      {
        "command": "agentproto.openStory",
        "title": "agentproto: Open Story",
        "category": "agentproto",
        "icon": "$(book)"
      },
      {
        "command": "agentproto.copySessionId",
        "title": "agentproto: Copy Session ID",
        "category": "agentproto",
        "icon": "$(copy)"
      },
      {
        "command": "agentproto.openTerminal",
        "title": "agentproto: Open Terminal",
        "category": "agentproto",
        "icon": "$(terminal)"
      },
      {
        "command": "agentproto.restartAsTerminal",
        "title": "agentproto: Restart as Terminal",
        "category": "agentproto",
        "icon": "$(terminal)"
      },
      {
        "command": "agentproto.moveTerminalLocation",
        "title": "agentproto: Move Terminal to Panel/Editor",
        "category": "agentproto",
        "icon": "$(layout)"
      },
      {
        "command": "agentproto.switchHarness",
        "title": "agentproto: Switch Harness",
        "category": "agentproto"
      },
      {
        "command": "agentproto.configureSession",
        "title": "agentproto: Configure Session",
        "category": "agentproto",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentproto.configureSessionAxis",
        "title": "agentproto: Configure Session Axis",
        "category": "agentproto"
      },
      {
        "command": "agentproto.openTranscriptChannel",
        "title": "agentproto: Open Transcript (Raw Output Channel)",
        "category": "agentproto"
      },
      {
        "command": "agentproto.approvePermission",
        "title": "agentproto: Approve Permission",
        "category": "agentproto",
        "icon": "$(check)"
      },
      {
        "command": "agentproto.denyPermission",
        "title": "agentproto: Deny Permission",
        "category": "agentproto",
        "icon": "$(close)"
      },
      {
        "command": "agentproto.compactSession",
        "title": "agentproto: Compact Session",
        "category": "agentproto",
        "icon": "$(fold)"
      },
      {
        "command": "agentproto.continueSessionFresh",
        "title": "agentproto: Continue Fresh",
        "category": "agentproto",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentproto.showHealth",
        "title": "agentproto: Show Daemon Health",
        "category": "agentproto"
      },
      {
        "command": "agentproto.showDaemonConfig",
        "title": "agentproto: Daemon Configuration",
        "category": "agentproto",
        "icon": "$(server-process)"
      },
      {
        "command": "agentproto.refreshHarnesses",
        "title": "agentproto: Refresh Harnesses",
        "category": "agentproto",
        "icon": "$(refresh)"
      },
      {
        "command": "agentproto.installHarness",
        "title": "agentproto: Install Harness",
        "category": "agentproto",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentproto.spawnWithHarness",
        "title": "agentproto: Spawn with Harness",
        "category": "agentproto",
        "icon": "$(play)"
      },
      {
        "command": "agentproto.refreshAuthProfiles",
        "title": "agentproto: Refresh Auth Profiles",
        "category": "agentproto",
        "icon": "$(refresh)"
      },
      {
        "command": "agentproto.configureAuthProfile",
        "title": "agentproto: Add Auth Profile",
        "category": "agentproto",
        "icon": "$(add)"
      },
      {
        "command": "agentproto.connectAuthProfile",
        "title": "agentproto: Connect Provider",
        "category": "agentproto",
        "icon": "$(plug)"
      },
      {
        "command": "agentproto.connectLocalLogin",
        "title": "agentproto: Use My Existing Local Login",
        "category": "agentproto",
        "icon": "$(sign-in)"
      },
      {
        "command": "agentproto.runOnboarding",
        "title": "agentproto: Set Up Credentials (Onboarding)",
        "category": "agentproto",
        "icon": "$(rocket)"
      },
      {
        "command": "agentproto.deleteAuthProfile",
        "title": "agentproto: Delete Auth Profile",
        "category": "agentproto",
        "icon": "$(trash)"
      },
      {
        "command": "agentproto.enableAuthProfile",
        "title": "agentproto: Enable Auth Profile",
        "category": "agentproto",
        "icon": "$(check)"
      },
      {
        "command": "agentproto.disableAuthProfile",
        "title": "agentproto: Disable Auth Profile",
        "category": "agentproto",
        "icon": "$(circle-slash)"
      },
      {
        "command": "agentproto.setAuthProfileModels",
        "title": "agentproto: Set Allowed Models…",
        "category": "agentproto",
        "icon": "$(add)"
      },
      {
        "command": "agentproto.openAuthSettings",
        "title": "agentproto: Open Auth Settings",
        "category": "agentproto",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentproto.startLlmEndpoint",
        "title": "agentproto: Start Local Router",
        "category": "agentproto",
        "icon": "$(play)"
      },
      {
        "command": "agentproto.stopLlmEndpoint",
        "title": "agentproto: Stop Local Router",
        "category": "agentproto",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentproto.reloadLlmEndpointPacks",
        "title": "agentproto: Reload Local Router Packs",
        "category": "agentproto",
        "icon": "$(refresh)"
      },
      {
        "command": "agentproto.testLlmEndpointUpstream",
        "title": "agentproto: Test Local Router Upstream",
        "category": "agentproto",
        "icon": "$(plug)"
      },
      {
        "command": "agentproto.linkLlmEndpointUpstream",
        "title": "agentproto: Link Local Router Upstream Credential",
        "category": "agentproto",
        "icon": "$(link)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentproto.refresh",
          "when": "view == 'agentproto.sessions' || view == 'agentproto.permissions'",
          "group": "navigation"
        },
        {
          "command": "agentproto.refreshHarnesses",
          "when": "view == 'agentproto.harnesses'",
          "group": "navigation"
        },
        {
          "command": "agentproto.refreshAuthProfiles",
          "when": "view == 'agentproto.authProfiles'",
          "group": "navigation"
        },
        {
          "command": "agentproto.openAuthSettings",
          "when": "view == 'agentproto.authProfiles'",
          "group": "navigation"
        },
        {
          "command": "agentproto.configureAuthProfile",
          "when": "view == 'agentproto.authProfiles'",
          "group": "navigation"
        },
        {
          "command": "agentproto.spawnAgent",
          "when": "view == 'agentproto.sessions'",
          "group": "navigation"
        },
        {
          "command": "agentproto.searchSessions",
          "when": "view == 'agentproto.sessions'",
          "group": "navigation"
        },
        {
          "command": "agentproto.filterSessions",
          "when": "view == 'agentproto.sessions'",
          "group": "navigation"
        },
        {
          "command": "agentproto.toggleShowArchived",
          "when": "view == 'agentproto.sessions'",
          "group": "navigation"
        },
        {
          "command": "agentproto.setSessionGrouping",
          "when": "view == 'agentproto.sessions'",
          "group": "navigation"
        },
        {
          "command": "agentproto.expandAllSessions",
          "when": "view == 'agentproto.sessions'",
          "group": "navigation"
        },
        {
          "command": "agentproto.cleanEndedSessions",
          "when": "view == 'agentproto.sessions'",
          "group": "navigation"
        },
        {
          "command": "agentproto.importConversation",
          "when": "view == 'agentproto.sessions'",
          "group": "navigation"
        },
        {
          "command": "agentproto.showDaemonConfig",
          "when": "view == 'agentproto.sessions'",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentproto.promptSession",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting)$/",
          "group": "inline@1"
        },
        {
          "command": "agentproto.interruptSession",
          "when": "view == agentproto.sessions && viewItem == session-live",
          "group": "inline@2"
        },
        {
          "command": "agentproto.killSession",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting)$/",
          "group": "inline@3"
        },
        {
          "command": "agentproto.openTranscript",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting|done|interrupted)(-archived)?$/",
          "group": "inline@4"
        },
        {
          "command": "agentproto.openStory",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting|done|interrupted)(-archived)?$/",
          "group": "modify@0"
        },
        {
          "command": "agentproto.restartSession",
          "when": "view == agentproto.sessions && viewItem =~ /^session-done(-archived)?$/",
          "group": "inline@5"
        },
        {
          "command": "agentproto.resumeSession",
          "when": "view == agentproto.sessions && viewItem =~ /^session-interrupted(-archived)?$/",
          "group": "inline@5"
        },
        {
          "command": "agentproto.restartSession",
          "when": "view == agentproto.sessions && viewItem =~ /^session-interrupted(-archived)?$/",
          "group": "1_config@3"
        },
        {
          "command": "agentproto.renameSession",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting|done|interrupted)(-archived)?$/",
          "group": "modify@1"
        },
        {
          "command": "agentproto.copySessionId",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting|done|interrupted)(-archived)?$/",
          "group": "modify@2"
        },
        {
          "command": "agentproto.saveFavorite",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting|done|interrupted)(-archived)?$/",
          "group": "modify@3"
        },
        {
          "command": "agentproto.archiveSession",
          "when": "view == agentproto.sessions && viewItem == session-done",
          "group": "inline@6"
        },
        {
          "command": "agentproto.unarchiveSession",
          "when": "view == agentproto.sessions && viewItem == session-done-archived",
          "group": "inline@6"
        },
        {
          "command": "agentproto.openTerminal",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting|done|interrupted)(-archived)?$/",
          "group": "inline@7"
        },
        {
          "command": "agentproto.switchHarness",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting)$/",
          "group": "inline@8"
        },
        {
          "command": "agentproto.openTranscriptChannel",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting|done|interrupted)(-archived)?$/",
          "group": "transcript@1"
        },
        {
          "command": "agentproto.approvePermission",
          "when": "view == agentproto.permissions && viewItem == permission-pending",
          "group": "inline@1"
        },
        {
          "command": "agentproto.denyPermission",
          "when": "view == agentproto.permissions && viewItem == permission-pending",
          "group": "inline@2"
        },
        {
          "command": "agentproto.spawnWithHarness",
          "when": "view == 'agentproto.harnesses' && viewItem =~ /^harness/",
          "group": "inline@1"
        },
        {
          "command": "agentproto.installHarness",
          "when": "view == 'agentproto.harnesses' && viewItem == harness-installable",
          "group": "inline@2"
        },
        {
          "command": "agentproto.connectAuthProfile",
          "when": "view == 'agentproto.authProfiles' && viewItem == auth-preset-unconnected",
          "group": "inline@1"
        },
        {
          "command": "agentproto.setAuthProfileModels",
          "when": "view == 'agentproto.authProfiles' && viewItem =~ /^auth-profile(-enabled|-disabled)?$/",
          "group": "inline@0"
        },
        {
          "command": "agentproto.deleteAuthProfile",
          "when": "view == 'agentproto.authProfiles' && viewItem =~ /^auth-profile(-enabled|-disabled)?$/",
          "group": "inline@2"
        },
        {
          "command": "agentproto.disableAuthProfile",
          "when": "view == 'agentproto.authProfiles' && viewItem == auth-profile-enabled",
          "group": "inline@1"
        },
        {
          "command": "agentproto.enableAuthProfile",
          "when": "view == 'agentproto.authProfiles' && viewItem == auth-profile-disabled",
          "group": "inline@1"
        },
        {
          "command": "agentproto.connectAuthProfile",
          "when": "view == 'agentproto.authProfiles' && viewItem == auth-preset-unconnected",
          "group": "9_actions@1"
        },
        {
          "command": "agentproto.setAuthProfileModels",
          "when": "view == 'agentproto.authProfiles' && viewItem =~ /^auth-profile(-enabled|-disabled)?$/",
          "group": "9_actions@0"
        },
        {
          "command": "agentproto.deleteAuthProfile",
          "when": "view == 'agentproto.authProfiles' && viewItem =~ /^auth-profile(-enabled|-disabled)?$/",
          "group": "9_actions@2"
        },
        {
          "command": "agentproto.disableAuthProfile",
          "when": "view == 'agentproto.authProfiles' && viewItem == auth-profile-enabled",
          "group": "9_actions@1"
        },
        {
          "command": "agentproto.enableAuthProfile",
          "when": "view == 'agentproto.authProfiles' && viewItem == auth-profile-disabled",
          "group": "9_actions@1"
        },
        {
          "command": "agentproto.startLlmEndpoint",
          "when": "view == 'agentproto.authProfiles' && viewItem == local-router-stopped",
          "group": "inline@1"
        },
        {
          "command": "agentproto.stopLlmEndpoint",
          "when": "view == 'agentproto.authProfiles' && viewItem == local-router-running",
          "group": "inline@1"
        },
        {
          "command": "agentproto.startLlmEndpoint",
          "when": "view == 'agentproto.authProfiles' && viewItem == local-router-stopped",
          "group": "9_actions@1"
        },
        {
          "command": "agentproto.stopLlmEndpoint",
          "when": "view == 'agentproto.authProfiles' && viewItem == local-router-running",
          "group": "9_actions@1"
        },
        {
          "command": "agentproto.reloadLlmEndpointPacks",
          "when": "view == 'agentproto.authProfiles' && viewItem == local-router-packs",
          "group": "inline@1"
        },
        {
          "command": "agentproto.reloadLlmEndpointPacks",
          "when": "view == 'agentproto.authProfiles' && viewItem == local-router-packs",
          "group": "9_actions@1"
        },
        {
          "command": "agentproto.linkLlmEndpointUpstream",
          "when": "view == 'agentproto.authProfiles' && viewItem == local-router-upstream",
          "group": "inline@1"
        },
        {
          "command": "agentproto.testLlmEndpointUpstream",
          "when": "view == 'agentproto.authProfiles' && viewItem == local-router-upstream",
          "group": "inline@2"
        },
        {
          "command": "agentproto.linkLlmEndpointUpstream",
          "when": "view == 'agentproto.authProfiles' && viewItem == local-router-upstream",
          "group": "9_actions@1"
        },
        {
          "command": "agentproto.testLlmEndpointUpstream",
          "when": "view == 'agentproto.authProfiles' && viewItem == local-router-upstream",
          "group": "9_actions@2"
        },
        {
          "command": "agentproto.configureSession",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting)$/",
          "group": "1_config@2"
        },
        {
          "command": "agentproto.compactSession",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting)$/",
          "group": "context@1"
        },
        {
          "command": "agentproto.continueSessionFresh",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting)$/",
          "group": "context@2"
        },
        {
          "command": "agentproto.setSessionAccessProfile",
          "when": "view == agentproto.sessions && viewItem =~ /^session-(live|awaiting|done|interrupted)(-archived)?$/",
          "group": "1_config@1"
        }
      ],
      "editor/title": [
        {
          "command": "agentproto.restartAsTerminal",
          "when": "activeWebviewPanelId == 'agentproto.transcript'",
          "group": "1_terminal"
        }
      ],
      "terminal/title": [
        {
          "command": "agentproto.moveTerminalLocation",
          "when": "agentproto.terminalFocused",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "agentproto",
      "properties": {
        "agentproto.daemonUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18790",
          "description": "Base URL of the local agentproto daemon."
        },
        "agentproto.tokenPath": {
          "type": "string",
          "default": "",
          "description": "Optional explicit path to the daemon's runtime.json token file. Empty = auto-resolve (~/.agentproto/daemons/<port>.json, then the workspace .agentproto/runtime.json when it names the same port)."
        },
        "agentproto.pollIntervalMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "Fallback poll interval (ms) when the session_events_poll loop is unhealthy."
        },
        "agentproto.authHeaders": {
          "type": "object",
          "default": {},
          "description": "Explicit HTTP headers to authenticate against a remote daemon (e.g. an attached sandbox's gated URL) — e.g. `{\"Cookie\": \"_port_auth=<token>\"}`. Takes precedence over the bearer token from `agentproto.tokenPath` when set."
        },
        "agentproto.holdPermissions": {
          "type": "boolean",
          "default": false,
          "description": "Spawn sessions in permission-hold mode: every tool-permission request is parked for your decision, listed in the Permissions view, and announced with an Approve/Deny notification. When off, the agent answers its own permission requests and there is nothing to approve. Override per spawn under Spawn Agent → Configure…"
        },
        "agentproto.confirmStop": {
          "type": "boolean",
          "default": true,
          "description": "Ask before stopping a session. When off, Stop terminates the agent immediately with no prompt — its transcript stays readable and the post-stop notification offers Restart. Turn this off here, or from the confirmation dialog itself via \"Stop and don't ask again\"."
        },
        "agentproto.sessionGrouping": {
          "type": "string",
          "enum": [
            "workspace",
            "origin",
            "status",
            "none"
          ],
          "enumDescriptions": [
            "One group per registered agentproto workspace (open folders first).",
            "One group per source — Claude Code (desktop), VS Code, cron, … — by the root session's origin.",
            "One group per state — Awaiting you, Live, Failed, Stopped, Done — by the root session's status.",
            "A single flat session list, no groups."
          ],
          "default": "workspace",
          "description": "How the Sessions panel groups its top level. Pick from the panel's toolbar (agentproto: Group Sessions By…)."
        },
        "agentproto.groupByWorkspace": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Superseded by agentproto.sessionGrouping. Still honoured for migration when sessionGrouping is unset (false → \"none\", otherwise \"workspace\").",
          "description": "Deprecated — use agentproto.sessionGrouping. Group the Sessions panel by registered agentproto workspace. Off restores the flat session list."
        },
        "agentproto.sessionsView": {
          "type": "string",
          "enum": [
            "tree",
            "webview"
          ],
          "enumDescriptions": [
            "The classic TreeView sessions panel.",
            "The newer Sessions webview panel — pinned filter, two-line rows, model/harness glyphs, subagent nesting, and an open-in-tab indicator."
          ],
          "default": "tree",
          "description": "Which Sessions panel to show in the sidebar."
        },
        "agentproto.harnessesView": {
          "type": "string",
          "enum": [
            "tree",
            "webview"
          ],
          "enumDescriptions": [
            "The classic TreeView harnesses panel.",
            "The newer Harnesses webview panel — real adapter logos, installable harness pills."
          ],
          "default": "tree",
          "description": "Which Harnesses panel to show in the sidebar."
        },
        "agentproto.authProfilesView": {
          "type": "string",
          "enum": [
            "tree",
            "webview"
          ],
          "enumDescriptions": [
            "The classic TreeView auth profiles panel.",
            "The newer Auth Profiles webview panel — collapsible sections, provider logos, expandable model profiles."
          ],
          "default": "tree",
          "description": "Which Auth Profiles panel to show in the sidebar."
        },
        "agentproto.autoAdoptLocalLogin": {
          "type": "string",
          "enum": [
            "auto",
            "ask",
            "off"
          ],
          "enumDescriptions": [
            "Silently adopt a detected local Claude Code login on first activation (only when no anthropic profile exists yet), creating a self-refreshing source-backed wallet.",
            "Offer a one-time prompt to adopt a detected local Claude Code login.",
            "Never detect or adopt a local login automatically."
          ],
          "default": "ask",
          "description": "On activation, whether to adopt an existing local Claude Code login as a self-refreshing auth profile. The token is resolved fresh from your local login per spawn — nothing is pasted or stored. You can always connect one manually from Auth Settings (\"Use my existing Claude Code login\")."
        }
      }
    }
  }
}
