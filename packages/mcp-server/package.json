{
  "name": "@agentproto/mcp-server",
  "version": "0.2.1",
  "description": "@agentproto/mcp-server — exposes every AIP doctype as MCP tools. Pass DoctypeSpec instances + an optional workspace dir for EXTENSION.md auto-loading; the server registers create_X / load_X / list_X / update_X / resolve_X / delete_X for each registered doctype, including AIP-40 extensions. Compose to build agent runtimes that author and edit AIP manifests over MCP.",
  "keywords": [
    "agentproto",
    "mcp",
    "modelcontextprotocol",
    "manifest",
    "tools",
    "agentic"
  ],
  "homepage": "https://agentproto.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproto/ts",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/agentproto/ts/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentproto/agent": "workspace:*",
    "@agentproto/define-doctype": "workspace:*",
    "@agentproto/driver": "workspace:*",
    "@agentproto/extension": "workspace:*",
    "@agentproto/manifest": "workspace:*",
    "@agentproto/routine": "workspace:*",
    "@agentproto/tool": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agentproto/tooling": "workspace:*",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
