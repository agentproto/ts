# Dependencies
node_modules
.pnpm-store

# Build output
dist
.turbo
.tsbuildinfo
*.tsbuildinfo

# `docs/mcp-tools` copied into the cli package by its tsup `onSuccess` step —
# tool-help.ts resolves them from the package root of the bundle (cli.mjs), so
# the published tarball ships them via the `files` array; never committed.
packages/cli/docs/

# Generated source — regenerated from canonical fixtures by prebuild hooks
packages/corpus-presets/src/marketing/files.ts
packages/corpus-presets/src/research/files.ts

# Generated panel HTML — single-file Vite builds of packages/apps' three
# panel UIs (work-board, review-panel, store), written by
# scripts/build-{work-board,review-panel,store}-ui.mjs and run through
# `generate:ui`, which the package's predev/prebuild/precheck-types/pretest
# hooks call. Built at build time, never committed: touching panel-bridge.ts
# or a panel UI used to mean regenerating and committing these (conflicts,
# and a stale bundle reaching main once — #1302).
packages/apps/src/work-board/panel.generated.ts
packages/apps/src/review-panel/panel.generated.ts
packages/apps/src/store/panel.generated.ts

# Generated Claude Code hook — regenerated from the canonical parser source by prebuild hooks
packages/runtime-profile-standard/files/.claude/hooks/user-prompt-submit.mjs

# Skill packs — skills/ + .claude-plugin/ are `pnpm build` output from
# src/skills/ + manifest.json (see packages/skill-pack-*/scripts/build.mjs).
# Never hand-edit or commit them; edit src/skills/ instead.
packages/skill-pack-agentproto/skills/
packages/skill-pack-agentproto/.claude-plugin/
packages/skill-pack-bureau/skills/
packages/skill-pack-bureau/.claude-plugin/
packages/skill-pack-agentpush/skills/
packages/skill-pack-agentpush/.claude-plugin/

# `agentproto pack skill`'s default --out — a local dev/dry-run scratch dir
# for building an arbitrary pack outside a package's own scripts/build.mjs.
# Never commit its output (that was the disease this repo used to have).
/.skills/

# catalog-sync local generator output (not the consumed model-catalog artifacts)
packages/catalog-sync/generated/

# agentproto daemon runtime state (workspace-local, never commit)
.agentproto/

# Exception: the repo-maintenance, session-steward and model-catalog-watch
# apps' checked-in bundled-app source (APP.md + agents/ + workflows/) — a
# hand-authored bundle, not daemon runtime state. `loadAppHandle`'s contract
# hardcodes `<dir>/.agentproto/APP.md`, so this directory name can't be
# avoided for a real app bundle.
!packages/apps/repo-maintenance/.agentproto/
!packages/apps/repo-maintenance/.agentproto/**
!packages/apps/session-steward/.agentproto/
!packages/apps/session-steward/.agentproto/**
!packages/apps/model-catalog-watch/.agentproto/
!packages/apps/model-catalog-watch/.agentproto/**

# git worktrees for parallel agent WPs (orchestration-local, never commit).
# Kept inside the repo root so the cowork sandbox can reach them; ignored here
# so they never pollute git status. gcloud auto-inherits .gitignore when no
# .gcloudignore exists, so Cloud Build/Run uploads skip them too.
.worktrees/

# agentflow per-dev opt-in overrides (committed defaults live in .agentflow.json)
.agentflow.local.json

# Editor
.DS_Store
.idea
.vscode
!.vscode/settings.json

# Env
.env
.env.local
.env.*.local

# Test coverage
coverage
.nyc_output

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# direnv local secrets — never commit
.envrc
.direnv/

# Design docs / planning — kept locally, never versioned
.docs/
.plans/
packages/vscode/*.vsix
.turbo-cache
# Shared turbo filesystem build cache (AGENTS.md recommends pointing at one
# dir across worktrees; never commit its artifacts)
.turbo-shared-cache
