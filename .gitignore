# Dependencies
node_modules
.pnpm-store

# Build output
dist
.turbo
.tsbuildinfo
*.tsbuildinfo

# Generated source — regenerated from canonical fixtures by prebuild hooks
packages/corpus-presets/src/marketing/files.ts
packages/corpus-presets/src/research/files.ts

# Generated Claude Code hook — regenerated from the canonical parser source by prebuild hooks
packages/runtime-profile-standard/files/.claude/hooks/user-prompt-submit.mjs

# agentproto daemon runtime state (workspace-local, never commit)
.agentproto/

# git worktrees for parallel agent WPs (orchestration-local, never commit).
# Kept inside the repo root so the cowork sandbox can reach them; ignored here
# so they never pollute git status. gcloud auto-inherits .gitignore when no
# .gcloudignore exists, so Cloud Build/Run uploads skip them too.
.worktrees/

# agentflow per-dev opt-in overrides (committed defaults live in .agentflow.json)
.agentflow.local.json

# Editor
.DS_Store
.idea
.vscode
!.vscode/settings.json

# Env
.env
.env.local
.env.*.local

# Test coverage
coverage
.nyc_output

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
