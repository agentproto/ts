# npm + pnpm config for @agentproto/* publishes.
#
# Auth via env var — the token itself never lives in this file. When
# NPM_TOKEN is set in the shell environment, npm/pnpm substitute
# ${NPM_TOKEN} below and use it for the registry.
#
# To set it: export NPM_TOKEN=npm_xxx in your shell before publishing.
# Generate a granular access token at
# https://www.npmjs.com/settings/agentiknet/tokens with "Bypass 2FA
# when publishing" enabled and scope @agentproto/*.
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
