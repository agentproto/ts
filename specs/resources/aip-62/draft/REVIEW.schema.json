{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentproto.sh/schemas/aip-62/REVIEW.schema.json",
  "title": "REVIEW.md frontmatter (kind: review)",
  "description": "The YAML frontmatter of a REVIEW.md review manifest, parsed to JSON. Field shapes only: the cross-field rules (unique ids, binding references, prepare/effects rules, implied default binding, explicit bindings when uses[] is present) are normative in AIP-62 and are enforced by the parser, not by this schema. Unknown keys are errors at every level.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "target", "checks"],
  "properties": {
    "kind": { "const": "review" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "target": {
      "description": "What is reviewed. v1 supports only a git range. The string form \"git-range\" is shorthand for { kind: git-range } with the default base (origin/main). The reviewed range is merge-base(base, HEAD)..HEAD.",
      "oneOf": [
        { "const": "git-range" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "git-range" },
            "base": { "type": "string", "minLength": 1, "default": "origin/main" }
          }
        }
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/commandCheck" },
          { "$ref": "#/$defs/agentCheck" }
        ]
      }
    },
    "bindings": {
      "description": "Named lane selections, keyed by binding id. When absent, an implied `default` binding over every non-effects check applies. When `uses` is present, explicit bindings are required.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/binding" }
    },
    "uses": {
      "type": "array",
      "items": { "$ref": "#/$defs/use" }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exportDir": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative directory attestation exports are written to and `verify` reads from."
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "checkRef": {
      "description": "A local check id, or `<as>/<id>` for a check contributed by a uses[] pack.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)?$",
      "maxLength": 129
    },
    "severity": { "enum": ["high", "medium", "low"] },
    "commandCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "run"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "command" },
        "description": { "type": "string" },
        "run": {
          "type": "string",
          "minLength": 1,
          "description": "Executed as `sh -c`. May contain {base}, {head}, {changed} placeholders; {{name}} escapes a literal {name}."
        },
        "cwd": { "type": "string", "description": "Relative to the repo root." },
        "blocking": { "type": "boolean", "default": true },
        "timeoutMs": { "type": "integer", "exclusiveMinimum": 0, "default": 600000 },
        "effects": {
          "type": "boolean",
          "default": false,
          "description": "true marks a prepare-only check that mutates the working tree. It MUST appear only in a binding's `prepare`."
        }
      }
    },
    "agentCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "preset", "rubric"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "agent" },
        "description": { "type": "string" },
        "preset": { "type": "string", "minLength": 1 },
        "rubric": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the directory containing REVIEW.md."
        },
        "blockOn": { "$ref": "#/$defs/severity", "default": "high" },
        "blocking": { "type": "boolean", "default": true },
        "timeoutMs": { "type": "integer", "exclusiveMinimum": 0, "default": 900000 },
        "effects": {
          "const": false,
          "description": "An agent check is always a read-only reviewer; effects: true is an error."
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "on": {
          "type": "string",
          "description": "Informational label (e.g. pre-push, pr). Nothing dispatches on it."
        },
        "prepare": {
          "type": "array",
          "items": { "$ref": "#/$defs/checkRef" },
          "description": "effects: true command checks, run in order before the range freezes."
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/checkRef" }
        },
        "quorum": { "const": "all-blocking-pass", "default": "all-blocking-pass" }
      }
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "as"],
      "properties": {
        "pack": {
          "type": "string",
          "description": "An npm package name, a relative path (./ or ../), an absolute path, or `git+https://<url>#<40-hex-sha>`. Other git+ schemes are not allowed and a git ref MUST be pinned to a full commit sha.",
          "pattern": "^(?!git\\+)\\S+$|^git\\+https://[^\\s#]+#[0-9a-f]{40}$"
        },
        "as": {
          "$ref": "#/$defs/id",
          "description": "Namespace: the pack's check `<id>` becomes `<as>/<id>` in this manifest."
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "description": "Subset of the pack's check ids to import. Default: all."
        },
        "preset": { "type": "string", "minLength": 1 },
        "overrides": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "blockOn": { "$ref": "#/$defs/severity" },
              "blocking": { "type": "boolean" },
              "timeoutMs": { "type": "integer", "exclusiveMinimum": 0 },
              "preset": { "type": "string", "minLength": 1 }
            }
          }
        },
        "allowCommands": { "type": "boolean", "default": false }
      }
    }
  }
}
