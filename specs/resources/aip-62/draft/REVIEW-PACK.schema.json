{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentproto.sh/schemas/aip-62/REVIEW-PACK.schema.json",
  "title": "REVIEW.md frontmatter (kind: review-pack)",
  "description": "The YAML frontmatter of a review pack: a reusable set of checks a REVIEW.md imports through uses[]. A pack has no target, bindings, or prepare phase, and none of its checks may have effects. Check ids MUST be unique within the pack (parser-enforced). Rubric paths are relative to the pack root and confined to it. Unknown keys are errors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "checks"],
  "properties": {
    "kind": { "const": "review-pack" },
    "id": { "$ref": "#/$defs/id" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/commandCheck" },
          { "$ref": "#/$defs/agentCheck" }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "commandCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "run"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "command" },
        "description": { "type": "string" },
        "run": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string" },
        "blocking": { "type": "boolean", "default": true },
        "timeoutMs": { "type": "integer", "exclusiveMinimum": 0, "default": 600000 },
        "effects": { "const": false }
      }
    },
    "agentCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "rubric"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "agent" },
        "description": { "type": "string" },
        "preset": {
          "type": "string",
          "minLength": 1,
          "description": "Optional in a pack. The consumer MUST supply one (override.preset, uses.preset, or this default) or resolution fails."
        },
        "rubric": { "type": "string", "minLength": 1 },
        "blockOn": { "enum": ["high", "medium", "low"], "default": "high" },
        "blocking": { "type": "boolean", "default": true },
        "timeoutMs": { "type": "integer", "exclusiveMinimum": 0, "default": 900000 },
        "effects": { "const": false }
      }
    }
  }
}
