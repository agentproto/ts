{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentproto.sh/schemas/aip-69/AuthProfile.schema.json",
  "title": "AIP-69 AuthProfile, authprofile/v1",
  "description": "A named reference to the credential a session bills or authenticates through. Never contains credential material. Host-specific keys MUST be prefixed x-.",
  "type": "object",
  "required": [
    "id",
    "endpoint",
    "method"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "not": {
    "required": [
      "credentialRef",
      "source"
    ]
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "description": "The billing endpoint (who bills), not the model builder."
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "description": "api-key | oauth-bearer | host-extensible."
    },
    "credentialRef": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque handle into the host credential store (an AIP-19 slug when available)."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "A credential source the host resolves at spawn and does not store."
    },
    "subaccount": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "subscription": {
      "$ref": "#/$defs/Subscription"
    },
    "policy": {
      "description": "AIP-38 PolicyRef: the profile as a resource."
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "origin": {
      "type": "string"
    }
  },
  "$defs": {
    "Subscription": {
      "type": "object",
      "required": [
        "monthlyUsd"
      ],
      "additionalProperties": false,
      "properties": {
        "monthlyUsd": {
          "type": "number",
          "minimum": 0
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "description": "Provider-defined window name (5h, weekly), not a duration."
              },
              "limit": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
