{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentproto.sh/docs/aip-53/APP.schema.json",
  "title": "APP.md frontmatter — app/v1 (agent app bundle + UI surface)",
  "description": "Validates the YAML frontmatter portion of an AIP-53 APP.md manifest — the on-disk form of an AppDefinition. Codifies shipped behaviour: `agents` may be empty for a UI-only app when `ui` is present (packages/app-kit/src/define-app.ts:49-52), and `data` / `category` are carried verbatim (packages/app-kit/src/types.ts).",
  "type": "object",
  "required": [
    "schema",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "app/v1",
      "description": "Exactly `app/v1`. Any other value MUST be refused by the loader."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Machine identifier for the app itself. Optional — an anonymous bundle cannot be installed by id. Written with any `@owner/` prefix as authored."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable app name."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][\\w.\\-]+)?$",
      "description": "App version. Defaulted to `0.1.0` by defineApp when `id` is set and version is omitted (conformance rule 8)."
    },
    "description": {
      "type": "string",
      "description": "App description. Also the APP.md markdown body."
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Path to the AGENT.md, relative to the app dir."
          }
        }
      },
      "description": "`{ id, path }` refs, one per bundled agent. MAY be empty ONLY when `ui` is present (UI-only app) — see the allOf guard below."
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Path to the WORKFLOW.md, relative to the app dir."
          }
        }
      },
      "description": "`{ id, path }` refs, one per bundled workflow. Every bundled workflow MUST be referenced by at least one agent's workflows[] (attachment invariant, both directions)."
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "description": "Optional home workspace id (AIP-34). When set, a sibling WORKSPACE.md exists at the app dir root."
    },
    "requires": {
      "description": "What the app needs from its host. Either a flat array of APP ids this app depends on (legacy form), or an object { browser?, fs?, gpu?, secrets?, apps? }. Each `apps` entry is a bare id (dependency only) or an object { id, version?, workflows? }: `version` is a semver range (exact \"1.2.3\", caret \"^1\"/\"^1.2\"/\"^1.2.3\", or tilde \"~1\"/\"~1.2\"/\"~1.2.3\") the provider's installed version must satisfy; `workflows` lists which of the provider's `exposes.workflows` this consumer may call via the app_call tool — omitted/empty means the dependency carries no call permission.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "browser": {
              "type": "boolean",
              "description": "Needs the user's real browser."
            },
            "fs": {
              "type": "boolean",
              "description": "Needs the user's local filesystem beyond app data."
            },
            "gpu": {
              "type": "boolean",
              "description": "Needs a GPU."
            },
            "secrets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Env/secret names the app needs."
            },
            "apps": {
              "type": "array",
              "description": "Other app ids this app depends on — bare ids or { id, version?, workflows? } objects.",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The depended-on app id."
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Optional semver range the provider's installed version must satisfy: exact (\"1.2.3\"), caret (\"^1\", \"^1.2\", \"^1.2.3\"), or tilde (\"~1\", \"~1.2\", \"~1.2.3\")."
                      },
                      "workflows": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": "Provider workflows (ids from its exposes.workflows) this consumer may call via app_call. Omitted/empty = dependency only, no call permission."
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "ui": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "const": ".agentproto/ui/index.html",
          "description": "The UI surface entry point."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The ui_tool_call / app_tool_call allowlist — every tool a UI-originated call may reach. Enforced server-side on every call."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Preferred local port hint for `app serve`."
        },
        "csp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "connectDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resourceDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "toolScope": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^\\$link\\.[A-Za-z0-9_]+$"
            }
          },
          "description": "Argument-level refinement of `tools`, keyed by tool id (which MUST also be in `tools`): argName -> \"$link.<claim>\" reference into a scoped app-link token's claims. Enforced only for calls made under a valid link/session token (AIP-53 link-token scoping); unaffected otherwise."
        }
      },
      "description": "The UI surface. `html` (the full document) is required on the in-memory AppDefinition at defineApp time and is NOT carried in APP.md frontmatter — it is emitted to `ui.path`. Its non-emptiness is enforced by defineApp (conformance rule 5)."
    },
    "artifact": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Emitted bundle path .agentproto/artifact/index.html."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "skill": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Emitted bundle path .agentproto/skill (must contain a SKILL.md)."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Artifact types this app's agents may produce, declared for discovery."
    },
    "dev": {
      "type": "object",
      "required": [
        "launch"
      ],
      "additionalProperties": false,
      "properties": {
        "launch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "runtimeExecutable"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "runtimeExecutable": {
                "type": "string",
                "minLength": 1
              },
              "runtimeArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "url": {
                "type": "string"
              }
            }
          },
          "description": "Dev-only launch recipes. Carried verbatim; NEVER executed by app-kit — `defineApp` validates the shape only (packages/app-kit/src/define-app.ts:62-64) and no loader/emit path runs it. The production hosting surface is `services` (below), not this."
        }
      },
      "description": "Dev-launch configuration, carried verbatim in frontmatter."
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "oneOf": [
          { "required": ["entry"], "not": { "required": ["args"] } },
          { "required": ["command"], "not": { "required": ["entry"] } }
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Service identifier — kebab-case slug, unique across the array."
          },
          "entry": {
            "type": "string",
            "minLength": 1,
            "description": "Legacy shell command line that starts the service (e.g. `pnpm --filter x start`, `node dist/server.js`). Carried verbatim; the loader/`defineApp` never executes it. Exactly one of entry/command."
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "description": "Structured (preferred) command form: the binary/script to run, never shell-interpreted — the runner passes it as argv[0]. Exactly one of entry/command."
          },
          "args": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Structured command form: argv after `command`, passed verbatim. Requires `command`."
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "description": "Working directory the runner starts the service in; relative paths resolve against the app's installed dir."
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Optional TCP port the service listens on. Omitted = a service that does not listen. One process per entry, one port."
          }
        }
      },
      "description": "Production hosting surface: one supervised service process per entry — NO dependency graph, NO scaling, NO scheduler. The host (NOT app-kit) spawns exactly one keep-alive service-owner session per entry at install time (later work item) that runs `entry`; `dev.launch` is NOT executed by the loader and is not this surface. Names MUST be unique. See the pending SERVICES schema draft (pending upstream spec PR)."
    },
    "setup": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/setupStep"
      },
      "description": "OPTIONAL ordered, idempotent post-install configuration pipeline (modelled on the AIP-29 `setup` block). Step ids MUST be unique; `when.step` MUST reference an earlier id. Root `additionalProperties` stays false: this property is added explicitly and only `x-*` vendor steps are open. See AIP-53 § Setup steps."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1,
          "description": "Default data-dir hint for the app_data_* plane, RELATIVE to the app dir (e.g. `data` means `<appDir>/data`). Overridden by an explicit dataDir at install time."
        }
      },
      "description": "Default data-directory hint (AppDataDefinition). See AIP-53 § The app data plane."
    },
    "externalReadRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Host directories the app is granted READ-ONLY access to outside its sandboxed dir (absolute or ~-relative). Carried verbatim in frontmatter by emit/load; validated to exist at install time. Read-only everywhere — there is no write/delete path for these roots."
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "Coarse grouping surfaced in host catalogs/trees (e.g. `book`). Freeform — not validated against a fixed enum."
    },
    "exposes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Agent ids this app exposes. Every id must name one of the app's own agents."
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Workflow ids this app exposes — the callable surface other apps' requires.apps[].workflows entries may name (consumed via the app_call tool). Every id must name one of the app's own workflows."
        }
      },
      "description": "A2A-visible agents/workflows. Ids must exist in the app's agents / workflows."
    }
  },
  "$defs": {
    "stepId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable step identifier, kebab-case, unique across `setup[]`. Appears in the ledger, audit logs and `--only`."
    },
    "skipIf": {
      "type": "object",
      "required": [
        "cmd"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer",
          "default": 0
        }
      },
      "description": "AIP-29 `skip_if`: when `cmd` exits with `exit_code` (default 0) the step is skipped and ledgered as `skippedViaSkipIf`."
    },
    "when": {
      "type": "object",
      "required": [
        "step"
      ],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "string",
          "description": "Id of an EARLIER step."
        },
        "equals": {
          "description": "Run only when that step's recorded answer equals this value."
        },
        "done": {
          "type": "boolean",
          "description": "Run only when that step is (true) / is not (false) complete."
        }
      },
      "oneOf": [
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "done"
          ]
        }
      ],
      "description": "Run the step only if the condition on an earlier step holds. Exactly one of `equals` / `done`."
    },
    "persist": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "secret_slug": {
          "type": "string",
          "minLength": 1
        },
        "cmd": {
          "type": "string",
          "minLength": 1,
          "description": "Run with `${value}` substituted (shell-escaped)."
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "description": "Dotted key under which the NON-SECRET value is recorded in the setup record's `answers`. MUST NOT be used for `type: secret`."
        }
      },
      "description": "Where the captured value lands. Exactly one slot."
    },
    "option": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "setupStep": {
      "oneOf": [
        {
          "title": "cmd step",
          "type": "object",
          "required": [
            "id",
            "kind",
            "cmd"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/stepId"
            },
            "kind": {
              "const": "cmd"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "optional": {
              "type": "boolean",
              "default": false,
              "description": "An optional step may be declined or left pending without blocking `ready`."
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "cmd": {
              "type": "string",
              "minLength": 1
            },
            "skip_if": {
              "$ref": "#/$defs/skipIf"
            },
            "persist": {
              "$ref": "#/$defs/persist"
            }
          }
        },
        {
          "title": "prompt step",
          "type": "object",
          "required": [
            "id",
            "kind",
            "prompt"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/stepId"
            },
            "kind": {
              "const": "prompt"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "optional": {
              "type": "boolean",
              "default": false,
              "description": "An optional step may be declined or left pending without blocking `ready`."
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "type": {
              "enum": [
                "text",
                "select",
                "boolean",
                "secret"
              ],
              "default": "text"
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "default": {},
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/option"
              }
            },
            "skip_if": {
              "$ref": "#/$defs/skipIf"
            },
            "persist": {
              "$ref": "#/$defs/persist"
            }
          }
        },
        {
          "title": "choice step",
          "type": "object",
          "required": [
            "id",
            "kind",
            "prompt",
            "options",
            "default"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/stepId"
            },
            "kind": {
              "const": "choice"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "optional": {
              "type": "boolean",
              "default": false,
              "description": "An optional step may be declined or left pending without blocking `ready`."
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/option"
              }
            },
            "default": {
              "type": "string",
              "description": "The `value` of one option. Pre-selected, and applied by `--yes`."
            },
            "persist": {
              "$ref": "#/$defs/persist"
            }
          }
        },
        {
          "title": "auth-profile step",
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/stepId"
            },
            "kind": {
              "const": "auth-profile"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "optional": {
              "type": "boolean",
              "default": false,
              "description": "An optional step may be declined or left pending without blocking `ready`."
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "min": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "Complete when at least this many enabled auth profiles exist."
            },
            "harnesses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Only count profiles usable by these harness slugs. Absent = any."
            }
          }
        },
        {
          "title": "pairing step",
          "type": "object",
          "required": [
            "id",
            "kind",
            "channel"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/stepId"
            },
            "kind": {
              "const": "pairing"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "optional": {
              "type": "boolean",
              "default": false,
              "description": "An optional step may be declined or left pending without blocking `ready`."
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "channel": {
              "type": "string",
              "minLength": 1,
              "description": "Open set. `telegram` is defined by AIP-53; other values are host-defined."
            },
            "display": {
              "enum": [
                "qr",
                "link",
                "code"
              ],
              "default": "qr"
            },
            "timeout_sec": {
              "type": "integer",
              "minimum": 1,
              "default": 300
            },
            "persist": {
              "$ref": "#/$defs/persist"
            }
          }
        },
        {
          "title": "oauth step",
          "type": "object",
          "required": [
            "id",
            "kind",
            "secret_slug"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/stepId"
            },
            "kind": {
              "const": "oauth"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "optional": {
              "type": "boolean",
              "default": false,
              "description": "An optional step may be declined or left pending without blocking `ready`."
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "secret_slug": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "title": "external step",
          "type": "object",
          "required": [
            "id",
            "kind",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/stepId"
            },
            "kind": {
              "const": "external"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "optional": {
              "type": "boolean",
              "default": false,
              "description": "An optional step may be declined or left pending without blocking `ready`."
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "persist": {
              "$ref": "#/$defs/persist"
            }
          }
        },
        {
          "title": "check step",
          "type": "object",
          "required": [
            "id",
            "kind",
            "check"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/stepId"
            },
            "kind": {
              "const": "check"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "optional": {
              "type": "boolean",
              "default": false,
              "description": "An optional step may be declined or left pending without blocking `ready`."
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "check": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "cmd": {
                  "type": "object",
                  "required": [
                    "run"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "run": {
                      "type": "string",
                      "minLength": 1
                    },
                    "exit_code": {
                      "type": "integer",
                      "default": 0
                    }
                  }
                },
                "tool": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "args": {
                      "type": "object"
                    },
                    "expect": {
                      "type": "object",
                      "description": "Subset the tool's result object MUST contain."
                    }
                  }
                }
              }
            },
            "severity": {
              "enum": [
                "required",
                "warn"
              ],
              "default": "required"
            }
          }
        },
        {
          "title": "vendor step",
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "additionalProperties": true,
          "properties": {
            "id": {
              "$ref": "#/$defs/stepId"
            },
            "kind": {
              "type": "string",
              "pattern": "^x-[a-z0-9-]+$"
            }
          },
          "description": "Vendor extension. The ONLY place in APP.md where unknown keys are tolerated. A host that does not implement the kind MUST fail with `setup_unsupported_step`, never skip it silently (unless `optional: true`)."
        }
      ]
    }
  },
  "allOf": [
    {
      "title": "UI-only carve-out",
      "description": "An app with an empty or absent `agents` array is conforming ONLY when `ui` is present (codifies packages/app-kit/src/define-app.ts:49-52 and the five builtin panels in packages/apps/src/index.ts that ship as agents: []).",
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "agents"
              ]
            }
          },
          {
            "properties": {
              "agents": {
                "maxItems": 0
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "ui"
        ]
      }
    },
    {
      "title": "Attachment invariant (structural part)",
      "description": "A UI-only app bundles zero workflows: a bundled workflow with no referencing agent would be an orphan (conformance rule 3).",
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "agents"
              ]
            }
          },
          {
            "properties": {
              "agents": {
                "maxItems": 0
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "workflows": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
