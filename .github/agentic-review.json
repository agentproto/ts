{
  "blocking": true,
  "model": "claude-sonnet-5",
  "fixDelivery": "commit",
  "botMention": "@agentproto-bot",
  "maxFixIterations": 3,
  "maxReviewTurns": 50,
  "cliSource": "npm",
  "cliVersion": "0.8.0",
  "reviewerAdapter": "claude-sdk",
  "reviewerAuthMode": "subscription",
  "describe": {
    "auto": true,
    "minBodyChars": 80
  },
  "merge": {
    "auto": false,
    "method": "squash",
    "requireAck": false,
    "ackLabel": "agentflow:ack",
    "maintainer": true,
    "escalateTo": "agentiknet",
    "alwaysEscalateGlobs": [
      "**/migrations/**",
      "**/*.sql",
      "**/auth/**",
      "**/security/**",
      ".github/workflows/**",
      "**/*.env*"
    ]
  },
  "skills": [
    "aip-conventions"
  ],
  "externalSkills": {
    "allow": [
      "DietrichGebert/ponytail@ponytail-review"
    ]
  },
  "commands": {
    "review": {
      "skills": [
        "aip-conventions",
        "ponytail-review"
      ]
    },
    "fix": {
      "skills": [
        "aip-conventions"
      ],
      "fixDelivery": "pr"
    },
    "pr": {
      "skills": [
        "aip-conventions"
      ],
      "fixDelivery": "pr"
    },
    "triage": {
      "skills": [
        "aip-conventions"
      ]
    },
    "discussion": {
      "skills": [
        "aip-conventions"
      ]
    },
    "wiki": {
      "skills": [
        "aip-conventions"
      ]
    },
    "explain": {
      "skills": []
    }
  }
}
