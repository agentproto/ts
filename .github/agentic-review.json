{
  "blocking": true,
  "model": "claude-sonnet-4-6",
  "fixDelivery": "commit",
  "botMention": "@agentproto-bot",
  "maxFixIterations": 3,
  "merge": {
    "auto": false,
    "method": "squash",
    "requireAck": false,
    "ackLabel": "agentflow:ack"
  },
  "skills": ["aip-conventions"],
  "externalSkills": {
    "allow": ["DietrichGebert/ponytail@ponytail-review"]
  },
  "commands": {
    "review": {
      "skills": ["aip-conventions", "ponytail-review"]
    },
    "fix": {
      "skills": ["aip-conventions"],
      "fixDelivery": "commit"
    },
    "pr": {
      "skills": ["aip-conventions"],
      "fixDelivery": "pr"
    },
    "triage": {
      "skills": ["aip-conventions"]
    },
    "discussion": {
      "skills": ["aip-conventions"]
    },
    "wiki": {
      "skills": ["aip-conventions"]
    },
    "explain": {
      "skills": []
    }
  }
}
