{
  "blocking": true,
  "model": "opencode/deepseek-v4.1-flash-free",
  "fixDelivery": "commit",
  "botMention": "@agentproto-bot",
  "maxFixIterations": 3,
  "maxReviewTurns": 50,
  "cliSource": "workspace",
  "cliVersion": "1.31.0",
  "agentPresets": {
    "opencode-mimo-free": {
      "reviewerAdapter": "opencode",
      "reviewerAuthMode": "api-key",
      "reviewerModel": "opencode/mimo-v2.6-flash-free",
      "reviewerSandboxEnv": [
        "OPENCODE_API_KEY",
        "GITHUB_TOKEN"
      ]
    },
    "opencode-step5-free": {
      "reviewerAdapter": "opencode",
      "reviewerAuthMode": "api-key",
      "reviewerModel": "opencode/step-5-preview-free",
      "reviewerSandboxEnv": [
        "OPENCODE_API_KEY",
        "GITHUB_TOKEN"
      ],
      "reviewerTurnRetry": {
        "on": [
          "rate-limit",
          "upstream-5xx",
          "no-output-stall",
          "usage-limit"
        ],
        "maxRetries": 6,
        "fallback": [
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          }
        ]
      }
    },
    "claude-cloud": {
      "cloud": "anthropic",
      "reviewerAdapter": "claude-code-cloud",
      "reviewerPlacement": null,
      "reviewerTurnRetry": null
    },
    "opencode-deepseek-free": {
      "reviewerAdapter": "opencode",
      "reviewerAuthMode": "api-key",
      "reviewerModel": "opencode/deepseek-v4.1-flash-free",
      "reviewerSandboxEnv": [
        "OPENCODE_API_KEY",
        "GITHUB_TOKEN"
      ]
    },
    "opencode-go-step5-free": {
      "reviewerAdapter": "opencode",
      "reviewerAuthMode": "api-key",
      "reviewerModel": "opencode-go/step-5-preview-free",
      "reviewerSandboxEnv": [
        "OPENCODE_API_KEY",
        "GITHUB_TOKEN"
      ],
      "reviewerTurnRetry": {
        "on": [
          "rate-limit",
          "upstream-5xx",
          "no-output-stall",
          "usage-limit"
        ],
        "maxRetries": 6,
        "fallback": [
          {
            "model": "opencode-go/deepseek-v4.1-flash"
          }
        ]
      }
    },
    "opencode-go-deepseek-flash": {
      "reviewerAdapter": "opencode",
      "reviewerAuthMode": "api-key",
      "reviewerModel": "opencode/mimo-v2.6-flash-free",
      "reviewerSandboxEnv": [
        "OPENCODE_API_KEY",
        "GITHUB_TOKEN"
      ]
    }
  },
  "agentActions": {
    "review": {
      "env": "AGENT_REVIEW_PRESETS",
      "presets": [
        "opencode-deepseek-free",
        "opencode-mimo-free"
      ]
    },
    "release-notes": {
      "env": "AGENT_RELEASE_NOTES_PRESETS",
      "presets": [
        "opencode-mimo-free",
        "opencode-step5-free"
      ]
    },
    "docs-check": {
      "env": "AGENT_DOCS_CHECK_PRESETS",
      "presets": [
        "opencode-mimo-free",
        "opencode-step5-free"
      ]
    }
  },
  "reviewerAdapter": "opencode",
  "reviewerAuthMode": "api-key",
  "reviewerModel": "opencode/deepseek-v4.1-flash-free",
  "reviewerPlacement": {
    "ladder": [
      {
        "sandbox": {
          "provider": "computer",
          "config": {
            "template": "agentproto-workstation",
            "cpus": 2,
            "memoryMiB": 4096,
            "fleetCapacityWaitMs": 240000,
            "egressIp": "auto",
            "egress": [
              "github.com",
              "api.github.com",
              "codeload.github.com",
              "objects.githubusercontent.com",
              "raw.githubusercontent.com",
              "registry.npmjs.org",
              "opencode.ai",
              "models.opencode.ai",
              "models.dev",
              "rdv.agentproto.sh"
            ]
          },
          "lifecycle": {
            "destroy_on": "workspace-close"
          }
        },
        "preflight": [
          "model-answers"
        ]
      },
      {
        "sandbox": {
          "provider": "e2b",
          "lifecycle": {
            "destroy_on": "workspace-close"
          }
        },
        "preflight": [
          "model-answers"
        ]
      },
      {
        "sandbox": {
          "provider": "computer",
          "config": {
            "template": "agentproto-workstation",
            "cpus": 2,
            "memoryMiB": 4096,
            "fleetCapacityWaitMs": 240000,
            "egressIp": "auto",
            "egress": [
              "github.com",
              "api.github.com",
              "codeload.github.com",
              "objects.githubusercontent.com",
              "raw.githubusercontent.com",
              "registry.npmjs.org",
              "opencode.ai",
              "models.opencode.ai",
              "models.dev",
              "rdv.agentproto.sh"
            ]
          },
          "lifecycle": {
            "destroy_on": "workspace-close"
          }
        },
        "model": "opencode-go/deepseek-v4.1-flash"
      }
    ]
  },
  "reviewerSandboxEnv": [
    "OPENCODE_API_KEY",
    "GITHUB_TOKEN"
  ],
  "reviewerTurnRetry": {
    "on": [
      "rate-limit",
      "upstream-5xx",
      "no-output-stall",
      "usage-limit"
    ],
    "maxRetries": 6,
    "rotate": [
      {
        "model": "opencode/mimo-v2.6-flash-free"
      },
      {
        "model": "opencode/deepseek-v4.1-flash-free"
      },
      {
        "model": "opencode/glm-5.3-flash-free"
      }
    ],
    "rotateOn": [
      "rate-limit",
      "upstream-5xx",
      "no-output-stall"
    ],
    "fallback": [
      {
        "model": "opencode-go/deepseek-v4.1-flash"
      }
    ]
  },
  "describe": {
    "auto": true,
    "minBodyChars": 80
  },
  "merge": {
    "auto": false,
    "method": "squash",
    "requireAck": false,
    "ackLabel": "agentflow:ack",
    "maintainer": true,
    "escalateTo": "agentiknet",
    "alwaysEscalateGlobs": [
      "**/migrations/**",
      "**/*.sql",
      "**/auth/**",
      "**/security/**",
      ".github/workflows/**",
      "**/*.env*"
    ]
  },
  "skills": [
    "aip-conventions"
  ],
  "externalSkills": {
    "allow": [
      "DietrichGebert/ponytail@ponytail-review"
    ]
  },
  "commands": {
    "review": {
      "skills": [
        "aip-conventions",
        "ponytail-review"
      ]
    },
    "fix": {
      "skills": [
        "aip-conventions"
      ],
      "fixDelivery": "pr",
      "reviewerModel": "opencode/deepseek-v4.1-flash-free"
    },
    "pr": {
      "skills": [
        "aip-conventions"
      ],
      "fixDelivery": "pr"
    },
    "triage": {
      "skills": [
        "aip-conventions"
      ]
    },
    "discussion": {
      "skills": [
        "aip-conventions"
      ]
    },
    "wiki": {
      "skills": [
        "aip-conventions"
      ]
    },
    "explain": {
      "skills": []
    }
  }
}
