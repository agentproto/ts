      "reviewerSandbox": {
        "provider": "auto",
        "lifecycle": {
          "destroy_on": "workspace-close"
        },
        "config": {
          "computer": {
            "template": "agentproto-workstation",
            "cpus": 2,
            "memoryMiB": 4096,
            "fleetCapacityWaitMs": 240000,
            "egress": [
              "github.com",
              "api.github.com",
              "codeload.github.com",
              "objects.githubusercontent.com",
              "raw.githubusercontent.com",
              "registry.npmjs.org",
              "opencode.ai",
              "models.opencode.ai",
              "models.dev",
              "rdv.agentproto.sh"
            ]
          },
          "overflow": {
            "enabled": true,
            "maxBoxesPerDay": 20,
            "maxEurPerDay": 5,
            "maxEurPerBox": 0.5,
            "allowSecrets": true,
            "secretAllowlist": [
              "OPENCODE_API_KEY",
              "GITHUB_TOKEN",
              "AGENTPROTO_JOIN",
              "AGENTPROTO_JOIN_NAME",
              "AGENTPROTO_JOIN_PROVIDER",
              "AGENTPROTO_JOIN_SANDBOX_ID",
              "AGENTPROTO_JOIN_LABELS"
            ]
          }
        }
      },
