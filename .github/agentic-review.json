{
  "blocking": true,
  "model": "opencode/mimo-v2.6-flash-free",
  "fixDelivery": "commit",
  "botMention": "@agentproto-bot",
  "maxFixIterations": 3,
  "maxReviewTurns": 50,
  "cliSource": "workspace",
  "cliVersion": "0.8.0",
  "agentPresets": {
    "opencode-mimo-free": {
      "reviewerAdapter": "opencode",
      "reviewerAuthMode": "api-key",
      "reviewerModel": "opencode/mimo-v2.6-flash-free",
      "reviewerSandbox": {
        "provider": "e2b",
        "lifecycle": {
          "destroy_on": "workspace-close"
        }
      },
      "reviewerSandboxEnv": [
        "OPENCODE_API_KEY",
        "GITHUB_TOKEN"
      ]
    },
    "opencode-step5-free": {
      "reviewerAdapter": "opencode",
      "reviewerAuthMode": "api-key",
      "reviewerModel": "opencode/step-5-preview-free",
      "reviewerSandbox": {
        "provider": "e2b",
        "lifecycle": {
          "destroy_on": "workspace-close"
        }
      },
      "reviewerSandboxEnv": [
        "OPENCODE_API_KEY",
        "GITHUB_TOKEN"
      ]
    },
    "claude-cloud": {
      "cloud": "anthropic",
      "reviewerAdapter": "claude-code-cloud"
    },
    "opencode-deepseek-free": {
      "reviewerAdapter": "opencode",
      "reviewerAuthMode": "api-key",
      "reviewerModel": "opencode/deepseek-v4.1-flash-free",
      "reviewerSandbox": {
        "provider": "e2b",
        "lifecycle": {
          "destroy_on": "workspace-close"
        }
      },
      "reviewerSandboxEnv": [
        "OPENCODE_API_KEY",
        "GITHUB_TOKEN"
      ]
    }
  },
  "agentActions": {
    "review": {
      "env": "AGENT_REVIEW_PRESETS",
      "presets": [
        "opencode-deepseek-free",
        "opencode-mimo-free",
        "opencode-step5-free",
        "claude-cloud"
      ]
    },
    "release-notes": {
      "env": "AGENT_RELEASE_NOTES_PRESETS",
      "presets": [
        "opencode-mimo-free",
        "opencode-step5-free"
      ]
    },
    "docs-check": {
      "env": "AGENT_DOCS_CHECK_PRESETS",
      "presets": [
        "opencode-mimo-free",
        "opencode-step5-free"
      ]
    }
  },
  "reviewerAdapter": "opencode",
  "reviewerAuthMode": "api-key",
  "reviewerModel": "opencode/mimo-v2.6-flash-free",
  "reviewerSandbox": {
    "provider": "e2b",
    "lifecycle": {
      "destroy_on": "workspace-close"
    }
  },
  "reviewerSandboxEnv": [
    "OPENCODE_API_KEY",
    "GITHUB_TOKEN"
  ],
  "describe": {
    "auto": true,
    "minBodyChars": 80
  },
  "merge": {
    "auto": false,
    "method": "squash",
    "requireAck": false,
    "ackLabel": "agentflow:ack",
    "maintainer": true,
    "escalateTo": "agentiknet",
    "alwaysEscalateGlobs": [
      "**/migrations/**",
      "**/*.sql",
      "**/auth/**",
      "**/security/**",
      ".github/workflows/**",
      "**/*.env*"
    ]
  },
  "skills": [
    "aip-conventions"
  ],
  "externalSkills": {
    "allow": [
      "DietrichGebert/ponytail@ponytail-review"
    ]
  },
  "commands": {
    "review": {
      "skills": [
        "aip-conventions",
        "ponytail-review"
      ]
    },
    "fix": {
      "skills": [
        "aip-conventions"
      ],
      "fixDelivery": "pr"
    },
    "pr": {
      "skills": [
        "aip-conventions"
      ],
      "fixDelivery": "pr"
    },
    "triage": {
      "skills": [
        "aip-conventions"
      ]
    },
    "discussion": {
      "skills": [
        "aip-conventions"
      ]
    },
    "wiki": {
      "skills": [
        "aip-conventions"
      ]
    },
    "explain": {
      "skills": []
    }
  }
}
