{
  "blocking": true,
  "model": "opencode/mimo-v2.6-flash-free",
  "fixDelivery": "commit",
  "botMention": "@agentproto-bot",
  "maxFixIterations": 3,
  "maxReviewTurns": 50,
  "cliSource": "workspace",
  "cliVersion": "0.8.0",
  "reviewerPreset": "opencode-free",
  "reviewerPresets": {
    "opencode-free": {
      "reviewerAdapter": "opencode",
      "reviewerAuthMode": "api-key",
      "reviewerModel": "opencode/mimo-v2.6-flash-free",
      "reviewerFallbackModels": ["opencode/step-5-preview-free"],
      "reviewerSandbox": {
        "provider": "e2b",
        "lifecycle": { "destroy_on": "workspace-close" }
      },
      "reviewerSandboxEnv": ["OPENCODE_API_KEY", "GITHUB_TOKEN"]
    },
    "claude-cloud": {
      "cloud": "anthropic",
      "reviewerAdapter": "claude-code-cloud"
    }
  },
  "reviewerAdapter": "opencode",
  "reviewerAuthMode": "api-key",
  "reviewerModel": "opencode/mimo-v2.6-flash-free",
  "reviewerSandbox": {
    "provider": "e2b",
    "lifecycle": { "destroy_on": "workspace-close" }
  },
  "reviewerSandboxEnv": ["OPENCODE_API_KEY", "GITHUB_TOKEN"],
  "describe": {
    "auto": true,
    "minBodyChars": 80
  },
  "merge": {
    "auto": false,
    "method": "squash",
    "requireAck": false,
    "ackLabel": "agentflow:ack",
    "maintainer": true,
    "escalateTo": "agentiknet",
    "alwaysEscalateGlobs": [
      "**/migrations/**",
      "**/*.sql",
      "**/auth/**",
      "**/security/**",
      ".github/workflows/**",
      "**/*.env*"
    ]
  },
  "skills": [
    "aip-conventions"
  ],
  "externalSkills": {
    "allow": [
      "DietrichGebert/ponytail@ponytail-review"
    ]
  },
  "commands": {
    "review": {
      "skills": [
        "aip-conventions",
        "ponytail-review"
      ]
    },
    "fix": {
      "skills": [
        "aip-conventions"
      ],
      "fixDelivery": "pr"
    },
    "pr": {
      "skills": [
        "aip-conventions"
      ],
      "fixDelivery": "pr"
    },
    "triage": {
      "skills": [
        "aip-conventions"
      ]
    },
    "discussion": {
      "skills": [
        "aip-conventions"
      ]
    },
    "wiki": {
      "skills": [
        "aip-conventions"
      ]
    },
    "explain": {
      "skills": []
    }
  }
}
